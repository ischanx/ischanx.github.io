---
import { site } from '../config';
import Icon from './Icon.astro';

const { navigation, socialLinks } = site;
const isHomePage =
  Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const isAboutPage =
  Astro.url.pathname === '/about' || Astro.url.pathname === '/about.html';
const hideBrand = isHomePage || isAboutPage;
const headerNavItems = navigation;
const normalizePath = (path: string) => {
  const withoutExtension = path.replace(/\.html$/, '');
  const withoutTrailingSlash = withoutExtension.replace(/\/$/, '');
  return withoutTrailingSlash || '/';
};
const currentPath = normalizePath(Astro.url.pathname);
const isActiveNavItem = (link: string) =>
  normalizePath(link) === currentPath;
---

<header
  class:list={[
    'site-header sticky top-0 z-50 h-14 border-b border-transparent bg-white/72 backdrop-blur-sm transition-all duration-300 dark:bg-[var(--theme-dark-page-bg)]/72',
    isHomePage && 'home-header',
    isAboutPage && 'about-header',
  ]}
>
  <nav
    class="mx-auto h-full max-w-6xl px-4"
  >
    <div
      class:list={[
        'header-inner relative flex items-center h-full',
        hideBrand ? 'justify-end' : 'justify-between',
      ]}
    >
      <div class="header-brand flex items-center overflow-hidden relative">
        <a
          href="/"
          class="flex items-center gap-2 sm:gap-3 text-lg font-bold text-neutral-900 dark:text-white transition-colors duration-300 blog-title"
          aria-label={`${site.title} 首页`}
        >
          <img
            src={site.avatar}
            alt={`${site.author} 的头像`}
            class="h-8 w-8 sm:h-9 sm:w-9 shrink-0 rounded-full object-cover ring-1 ring-neutral-300/80 dark:ring-neutral-700/90"
            loading="eager"
            decoding="async"
          />
          <span>{site.title}</span>
        </a>
      </div>

      <div
        class="flex items-center gap-1"
      >
        <!-- 桌面端菜单 -->
        <div class="hidden md:flex items-center">
          {
            headerNavItems.map((item, index) => (
              <a
                href={item.link}
                class:list={[
                  'text-muted-foreground hover:text-primary dark:text-muted-foreground dark:hover:text-primary transition-all duration-300 flex items-center relative after:absolute after:bg-primary after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:duration-300 after:origin-left',
                  'px-2.5 py-2 text-[13px] font-medium tracking-[0.02em] after:bottom-0 after:left-2.5 after:right-2.5 after:h-px',
                  isActiveNavItem(item.link) &&
                    'text-primary dark:text-primary after:scale-x-100',
                ]}
                style={`animation-delay: ${index * 100}ms`}
                target={item.target}
                aria-current={
                  isActiveNavItem(item.link) ? 'page' : undefined
                }
              >
                <span>{item.text}</span>
              </a>
            ))
          }

          <!-- 搜索按钮 -->
          <button
            id="search-button"
            class:list={[
              'text-sm text-muted-foreground hover:text-primary dark:text-muted-foreground dark:hover:text-primary transition-all duration-300 py-2 flex items-center gap-1.5',
              'ml-1 border-l border-neutral-900/10 pl-4 pr-2 dark:border-white/10',
            ]}
            aria-label="搜索"
          >
            <Icon name="search" class="text-sm" />
            <span>搜索</span>
          </button>
        </div>

        <!-- 移动端菜单按钮 -->
        <div class="md:hidden flex items-center">
          <!-- 移动端搜索按钮 -->
          <button
            id="mobile-search-button"
            class="text-muted-foreground hover:text-primary dark:text-muted-foreground dark:hover:text-primary p-2 rounded-md"
            aria-label="搜索"
          >
            <Icon name="search" fontSize="20px" />
          </button>

          <button
            id="mobile-menu-button"
            class="text-muted-foreground hover:text-primary dark:text-muted-foreground dark:hover:text-primary p-2 rounded-md"
            aria-label="菜单"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="flex items-center">
          <button
            id="theme-toggle"
            class:list={[
              'text-muted-foreground hover:text-primary dark:text-muted-foreground dark:hover:text-primary transition-all duration-300 ms-1',
              'p-2',
            ]}
            aria-label="切换主题"
          >
            <span class="sr-only">切换主题</span>
            <Icon name="sun" fontSize="20px" class="dark:hidden" />
            <Icon name="moon" fontSize="20px" class="hidden dark:inline" />
          </button>
        </div>
      </div>
    </div>
  </nav>

  <!-- 移动端下拉菜单 -->
  <div
    id="mobile-menu"
    class:list={[
      'md:hidden absolute left-0 z-50 w-full invisible -translate-y-full opacity-0 border-b border-white/55 bg-neutral-100/96 shadow-lg shadow-black/5 backdrop-blur-lg backdrop-saturate-125 transition-all duration-300 dark:border-white/14 dark:bg-[var(--theme-dark-page-bg)]/96 dark:shadow-black/20',
      'top-14',
    ]}
  >
    <div class="container mx-auto px-4 sm:px-4 py-2">
      {
        headerNavItems.map(item => (
          <a
            href={item.link}
            class:list={[
              'block text-muted-foreground hover:text-primary dark:text-muted-foreground dark:hover:text-primary py-2 px-4 my-1 rounded flex items-center justify-center gap-2 relative after:absolute after:bottom-1 after:left-1/4 after:right-1/4 after:h-0.5 after:bg-primary after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:duration-300 after:origin-left text-center',
              isActiveNavItem(item.link) &&
                'text-primary dark:text-primary bg-neutral-200/60 dark:bg-neutral-800/60 after:scale-x-100',
            ]}
            target={item.target}
            aria-current={
              isActiveNavItem(item.link) ? 'page' : undefined
            }
          >
            {item.icon && <Icon name={item.icon} />}
            <span>{item.text}</span>
          </a>
        ))
      }

      <!-- 移动端搜索菜单项 -->
      <button
        id="mobile-menu-search"
        class="w-full block text-muted-foreground hover:text-primary dark:text-muted-foreground dark:hover:text-primary py-2 px-4 my-1 rounded flex items-center justify-center gap-2 relative after:absolute after:bottom-1 after:left-1/4 after:right-1/4 after:h-0.5 after:bg-primary after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:duration-300 after:origin-left text-center"
      >
        <Icon name="search" />
        <span>搜索</span>
      </button>
    </div>
  </div>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const html = document.documentElement;
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  // 搜索按钮
  const searchButton = document.getElementById('search-button');
  const mobileSearchButton = document.getElementById('mobile-search-button');
  const mobileMenuSearch = document.getElementById('mobile-menu-search');

  // 处理搜索按钮点击
  function handleSearchClick() {
    // 如果全局搜索函数存在
    if (typeof window.openGlobalSearch === 'function') {
      window.openGlobalSearch();
    } else {
      // 否则导航到搜索页面
      window.location.href = '/search';
    }
  }

  // 添加搜索按钮事件监听
  searchButton?.addEventListener('click', handleSearchClick);
  mobileSearchButton?.addEventListener('click', handleSearchClick);

  function isMobileMenuOpen() {
    return mobileMenu?.classList.contains('translate-y-0') ?? false;
  }

  function closeMobileMenu() {
    mobileMenu?.classList.add('invisible', '-translate-y-full', 'opacity-0');
    mobileMenu?.classList.remove('translate-y-0', 'opacity-100');
  }

  function openMobileMenu() {
    mobileMenu?.classList.remove('invisible', '-translate-y-full', 'opacity-0');
    mobileMenu?.classList.add('translate-y-0', 'opacity-100');
  }

  function toggleMobileMenu() {
    if (isMobileMenuOpen()) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  }

  mobileMenuSearch?.addEventListener('click', () => {
    // 先关闭菜单，再打开搜索
    closeMobileMenu();

    // 延迟一下再打开搜索，避免动画冲突
    setTimeout(handleSearchClick, 300);
  });

  // 移动端菜单切换
  mobileMenuButton?.addEventListener('click', event => {
    event.stopPropagation();
    toggleMobileMenu();
  });

  document.addEventListener('click', event => {
    if (!isMobileMenuOpen() || !mobileMenuButton || !mobileMenu) return;

    const target = event.target;
    if (!(target instanceof Node)) return;

    if (
      mobileMenu.contains(target) ||
      mobileMenuButton.contains(target)
    ) {
      return;
    }

    closeMobileMenu();
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      closeMobileMenu();
    }
  });

  themeToggle?.addEventListener('click', () => {
    html.classList.toggle('dark');
    html.style.colorScheme = html.classList.contains('dark')
      ? 'dark'
      : 'light';
    localStorage.setItem(
      'theme',
      html.classList.contains('dark') ? 'dark' : 'light'
    );
  });

  const header = document.querySelector('header');
  const homeHeroIdentity = document.querySelector('.blog-hero__identity');

  function updateHeaderState() {
    if (!header) return;

    const currentScrollY = window.scrollY;
    const isHomeHeader = header.classList.contains('home-header');
    const identityBounds = homeHeroIdentity?.getBoundingClientRect();
    const headerHeight = header.getBoundingClientRect().height;
    const showHomeBrand = isHomeHeader && identityBounds
      ? identityBounds.bottom <= headerHeight
      : false;

    header.classList.toggle('has-home-brand', showHomeBrand);
    header.classList.toggle('is-scrolled', currentScrollY > 32);
  }

  // 滚动效果 - 导航栏阴影变化
  window.addEventListener('scroll', updateHeaderState, { passive: true });
  window.addEventListener('resize', updateHeaderState, { passive: true });
  updateHeaderState();
</script>

<style>
  header {
    --primary: 221.2 83.2% 53.3%;
    --primary-foreground: 210 20% 98%;
    --primary-color: hsl(221.2 83.2% 53.3%);
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }

  :global(.dark) header {
    --primary: 217.2 91.2% 59.8%;
    --primary-foreground: 210 20% 98%;
    --primary-color: hsl(217.2 91.2% 59.8%);
  }

  header.site-header {
    backdrop-filter: blur(18px) saturate(1.08);
  }

  header.home-header .header-brand {
    height: 100%;
    left: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    top: 0;
    visibility: hidden;
    transition:
      opacity 260ms ease,
      visibility 0s linear 420ms;
  }

  header.home-header.has-home-brand .header-brand {
    opacity: 0.96;
    pointer-events: auto;
    transition:
      opacity 320ms ease,
      visibility 0s;
    visibility: visible;
  }

  header.about-header .header-brand {
    display: none;
  }

  header.site-header.is-scrolled {
    background-color: rgb(255 255 255 / 0.9);
    border-bottom-color: rgb(23 23 23 / 0.1);
    box-shadow: 0 1px 0 rgb(23 23 23 / 0.08);
  }

  :global(.dark) header.site-header.is-scrolled {
    background-color: rgb(25 25 25 / 0.9);
    border-bottom-color: rgb(255 255 255 / 0.1);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.08);
  }

  /* 移动端菜单样式 */
  #mobile-menu {
    max-height: calc(100vh - 56px);
    overflow-y: auto;
  }

  .blog-title {
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    will-change: transform;
    transform-origin: left;
  }
</style>
