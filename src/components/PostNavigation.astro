---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { getPostUrl } from '../utils/route';

interface Props {
  prevPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
}

const { prevPost, nextPost } = Astro.props;
---

<nav class="post-navigation" aria-label="文章导航">
  {
    prevPost ? (
      <a class="post-navigation__item" href={getPostUrl(prevPost)}>
        <span class="post-navigation__direction">
          <Icon name="arrow-left" fontSize="14px" />
          上一篇
        </span>
        <span class="post-navigation__title">{prevPost.data.title}</span>
      </a>
    ) : (
      <div class="post-navigation__item is-disabled" aria-disabled="true">
        <span class="post-navigation__direction">
          <Icon name="arrow-left" fontSize="14px" />
          上一篇
        </span>
        <span class="post-navigation__title">没有更多文章</span>
      </div>
    )
  }

  {
    nextPost ? (
      <a
        class="post-navigation__item post-navigation__item--next"
        href={getPostUrl(nextPost)}
      >
        <span class="post-navigation__direction">
          下一篇
          <Icon name="arrow-right" fontSize="14px" />
        </span>
        <span class="post-navigation__title">{nextPost.data.title}</span>
      </a>
    ) : (
      <div
        class="post-navigation__item post-navigation__item--next is-disabled"
        aria-disabled="true"
      >
        <span class="post-navigation__direction">
          下一篇
          <Icon name="arrow-right" fontSize="14px" />
        </span>
        <span class="post-navigation__title">没有更多文章</span>
      </div>
    )
  }
</nav>

<style>
  .post-navigation {
    border-top: 1px solid rgb(23 23 23 / 0.08);
    display: grid;
    gap: clamp(2rem, 6vw, 5rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 2.5rem;
    padding-top: 1.35rem;
  }

  .post-navigation__item {
    color: rgb(64 64 64);
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-block: 0.35rem;
    text-decoration: none;
  }

  .post-navigation__item--next {
    align-items: flex-end;
    text-align: right;
  }

  .post-navigation__direction {
    align-items: center;
    color: rgb(148 148 148);
    display: inline-flex;
    font-size: 0.72rem;
    gap: 0.4rem;
    line-height: 1.5;
    margin-bottom: 0.45rem;
  }

  .post-navigation__direction :global(svg) {
    transition: transform 180ms ease;
  }

  .post-navigation__title {
    display: -webkit-box;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.55;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 180ms ease;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  a.post-navigation__item:hover .post-navigation__title {
    color: hsl(var(--primary));
  }

  a.post-navigation__item:hover .post-navigation__direction :global(svg) {
    transform: translateX(-0.18rem);
  }

  a.post-navigation__item--next:hover
    .post-navigation__direction
    :global(svg) {
    transform: translateX(0.18rem);
  }

  a.post-navigation__item:focus-visible {
    border-radius: 2px;
    outline: 2px solid hsl(var(--primary) / 0.68);
    outline-offset: 4px;
  }

  .post-navigation__item.is-disabled {
    color: rgb(163 163 163);
    opacity: 0.58;
  }

  :global(.dark) .post-navigation {
    border-top-color: rgb(255 255 255 / 0.09);
  }

  :global(.dark) .post-navigation__item {
    color: rgb(212 212 212);
  }

  :global(.dark) .post-navigation__direction {
    color: rgb(115 115 115);
  }

  :global(.dark) .post-navigation__item.is-disabled {
    color: rgb(115 115 115);
  }

  @media (max-width: 640px) {
    .post-navigation {
      gap: 1.35rem;
      grid-template-columns: 1fr;
      margin-top: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-navigation__direction :global(svg),
    .post-navigation__title {
      transition: none;
    }
  }
</style>
