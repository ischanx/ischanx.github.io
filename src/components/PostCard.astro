---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/date';
import { readingTime } from '../utils/content';
import { getPostUrl } from '../utils/route';
import Icon from './Icon.astro';
import { site } from '../config';
import { createTagUrl, getTagLabel, normalizeTags } from '../utils/navigation';

interface Props {
  post: CollectionEntry<'blog'>;
  variant?: 'card' | 'list';
}

const { post, variant = 'card' } = Astro.props;
const { title, description, createDate, tags, sticky, image } = post.data;
const normalizedTags = normalizeTags(tags);

// 文章最终显示的图片
const displayImage = image;

// 获取置顶配置
const pinnedBadge = site.posts.pinnedBadge;

// 获取原始Markdown内容
const rawContent = post.body ?? '';
// 计算阅读时间
const readTime = readingTime(rawContent);

---

<article
  class:list={[
    'post-card group relative w-full animate-fade-in overflow-hidden transition-all duration-300 active:scale-[0.99]',
    variant === 'list' ? 'post-card--list' : 'rounded-lg',
  ]}
>
  <a
    href={getPostUrl(post)}
    class="card-link"
    aria-label={`阅读文章：${title}`}
  ></a>

  <!-- 卡片内容 -->
  <div
    class:list={[
      'relative z-10 flex min-h-40 h-full flex-col overflow-hidden pointer-events-none transition-all duration-300',
      variant === 'list'
        ? 'rounded-none bg-transparent px-3 py-5 sm:px-4 md:py-6 dark:bg-transparent'
        : 'rounded-lg bg-neutral-50/90 p-5 dark:bg-neutral-900/90',
    ]}
  >
    <!-- 标题 -->
    <h2
      class:list={[
        'font-bold mb-2 relative',
        variant === 'list'
          ? 'text-[15px] md:text-lg'
          : 'text-base md:text-xl',
        displayImage && 'md:pr-[205px]',
      ]}
    >
      <span
        class:list={[
          'post-title text-card-foreground transition-colors duration-300 dark:text-neutral-400',
          'group-hover:text-primary dark:group-hover:text-primary',
        ]}
      >
        {title}
      </span>

      {/* 置顶标签 */}
      {
        sticky && pinnedBadge.enabled && (
          <span class="inline-flex items-center ml-2 px-1.5 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300">
            {pinnedBadge.icon && (
              <Icon name={pinnedBadge.icon} class="mr-1 text-xs" />
            )}
            {pinnedBadge.label}
          </span>
        )
      }
    </h2>

    <!-- 封面图：桌面端 16:10 右侧缩略图，移动端使用更紧凑的宽幅横图 -->
    {
      displayImage && (
        <div
          class:list={[
            'post-cover relative z-20 mb-4 aspect-[9/4] w-full shrink-0 overflow-hidden rounded-md border border-neutral-200 bg-neutral-100 pointer-events-none md:absolute md:top-5 md:mb-0 md:aspect-[16/10] md:w-[180px] dark:border-neutral-700 dark:bg-neutral-800',
            variant === 'list' ? 'md:right-4' : 'md:right-5',
          ]}
        >
          <img
            src={displayImage}
            alt=""
            class:list={[
              'absolute inset-0 h-full w-full object-cover transition-opacity duration-300',
              variant === 'list'
                ? 'opacity-[0.86] group-hover:opacity-95'
                : 'opacity-90 group-hover:opacity-100',
            ]}
          />
        </div>
      )
    }

    <!-- 摘要 -->
    <p
      class:list={[
        'post-description text-sm text-muted-foreground dark:text-muted-foreground mb-3 line-clamp-3 overflow-hidden text-ellipsis pointer-events-none transition-all duration-300',
        displayImage && 'md:pr-[205px]',
      ]}
    >
      {description}
    </p>

    <!-- 元信息 -->
    <div
      class:list={[
        'post-meta flex flex-wrap items-center text-[10px] sm:text-xs text-muted-foreground dark:text-muted-foreground gap-2 sm:gap-3 mt-auto transition-all duration-300',
        displayImage && 'md:pr-[205px]',
      ]}
    >
      <time
        datetime={createDate.toISOString()}
        class="flex items-center pointer-events-none"
      >
        <Icon name="calendar" fontSize="14px" class="mr-1" />
        {formatDate(createDate)}
      </time>

      {
        normalizedTags.length > 0 && (
          <span class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <Icon name="tags" fontSize="14px" />
            {normalizedTags.map((tag: string) => (
              <a
                href={createTagUrl(tag)}
                class="pointer-events-auto inline-flex items-center gap-[2px] hover:text-primary dark:hover:text-primary transition-colors duration-300"
              >
                <span aria-hidden="true">#</span>
                <span>{getTagLabel(tag)}</span>
              </a>
            ))}
          </span>
        )
      }

      <span
        class="flex items-center pointer-events-none"
        aria-label={`预计阅读时间 ${readTime} 分钟`}
      >
        <Icon name="clock" fontSize="14px" class="mr-1" />
        {readTime} 分钟
      </span>
    </div>
  </div>
</article>

<style>
  .post-card:not(.post-card--list) {
    border: 1px solid rgb(212 212 212 / 0.95);
    box-shadow: 3px 3px 0 rgb(23 23 23 / 0.045);
  }

  :global(.dark) .post-card:not(.post-card--list) {
    border-color: rgb(82 82 82 / 0.9);
    box-shadow: 3px 3px 0 rgb(255 255 255 / 0.035);
  }

  .post-card:not(.post-card--list):hover,
  .post-card:not(.post-card--list):focus-within {
    border-color: rgb(115 115 115);
    box-shadow: 4px 4px 0 rgb(23 23 23 / 0.075);
  }

  :global(.dark) .post-card:not(.post-card--list):hover,
  :global(.dark) .post-card:not(.post-card--list):focus-within {
    border-color: rgb(115 115 115);
    box-shadow: 4px 4px 0 rgb(255 255 255 / 0.06);
  }

  .post-card--list {
    border-bottom: 1px dashed rgb(212 212 212 / 0.55);
    transition:
      background-color 220ms ease,
      transform 300ms ease;
  }

  .post-card--list .post-title {
    color: #171717;
  }

  .post-card--list:hover,
  .post-card--list:focus-within {
    background-color: rgb(229 229 229 / 0.42);
  }

  .post-card--list:hover .post-title,
  .post-card--list:focus-within .post-title {
    color: #171717;
  }

  .post-card--list:hover .post-description,
  .post-card--list:hover .post-meta,
  .post-card--list:focus-within .post-description,
  .post-card--list:focus-within .post-meta {
    color: #525252;
  }

  :global(.dark) .post-card--list {
    border-bottom-color: rgb(82 82 82 / 0.58);
  }

  :global(.dark) .post-card--list .post-title {
    color: #eeeeee;
  }

  :global(.dark) .post-card--list:hover,
  :global(.dark) .post-card--list:focus-within {
    background-color: rgb(50 50 50 / 0.52);
  }

  :global(.dark) .post-card--list:hover .post-title,
  :global(.dark) .post-card--list:focus-within .post-title {
    color: #fafafa;
  }

  :global(.dark) .post-card--list:hover .post-description,
  :global(.dark) .post-card--list:hover .post-meta,
  :global(.dark) .post-card--list:focus-within .post-description,
  :global(.dark) .post-card--list:focus-within .post-meta {
    color: #d4d4d4;
  }

  .card-link {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    cursor: pointer;
  }

  .card-link:focus-visible {
    outline: 2px solid rgb(82 82 82);
    outline-offset: -4px;
  }
</style>
