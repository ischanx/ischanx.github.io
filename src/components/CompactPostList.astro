---
import type { CollectionEntry } from 'astro:content';
import { getPostUrl } from '../utils/route';
import {
  createTagUrl,
  getTagLabel,
  getTagSlug,
  normalizeTags,
} from '../utils/navigation';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<div class="overflow-hidden">
  <table class="w-full">
    <thead>
      <tr class="border-b border-neutral-200 dark:border-neutral-700">
        <th
          class="text-left py-3 px-4 font-semibold text-neutral-700 dark:text-neutral-300"
          >标题</th
        >
        <th
          class="text-right py-3 px-4 font-semibold text-neutral-700 dark:text-neutral-300"
          >标签</th
        >
      </tr>
    </thead>
    <tbody>
      {
        posts.map(post => (
          <tr
            class="border-b border-neutral-200 dark:border-neutral-700 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors"
          >
            <td class="py-3 px-4">
              <a
                href={getPostUrl(post)}
                class="text-neutral-900 dark:text-neutral-200 hover:text-primary-600 dark:hover:text-primary-400 transition-colors font-medium"
              >
                {post.data.title}
              </a>
            </td>
            <td class="py-3 px-4 text-right">
              <div class="flex gap-2 justify-end flex-wrap">
                {normalizeTags(post.data.tags).length > 0 ? (
                  normalizeTags(post.data.tags).map((tag: string) => {
                    const slug = getTagSlug(tag);
                    const label = getTagLabel(tag);
                    const className = 'text-xs px-2 py-1 bg-neutral-100 dark:bg-neutral-700 rounded text-neutral-700 dark:text-neutral-300 hover:bg-primary-50 dark:hover:bg-primary-950/40 hover:text-primary-700 dark:hover:text-primary-300 transition-colors';

                    return slug ? (
                      <a
                        href={createTagUrl(tag)}
                        class={className}
                        onclick="event.stopPropagation()"
                      >
                        #{label}
                      </a>
                    ) : (
                      <span class={className}>#{label}</span>
                    );
                  })
                ) : (
                  <span class="text-sm text-neutral-400 dark:text-neutral-500">-</span>
                )}
              </div>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
