---
import type { CollectionEntry } from 'astro:content';
import { getPostUrl } from '../utils/route';
import {
  createTagUrl,
  getTagLabel,
  getTagSlug,
  normalizeTags,
} from '../utils/navigation';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ol class="compact-posts">
  {
    posts.map(post => {
      const tags = normalizeTags(post.data.tags);
      const date = post.data.createDate;

      return (
        <li class="compact-posts__item">
          <time datetime={date.toISOString()}>
            {date.toLocaleDateString('zh-CN', {
              month: '2-digit',
              day: '2-digit',
            })}
          </time>
          <div class="compact-posts__content">
            <a class="compact-posts__title" href={getPostUrl(post)}>
              {post.data.title}
            </a>
            {tags.length > 0 && (
              <div class="compact-posts__tags" aria-label="文章标签">
                {tags.map((tag: string) => {
                  const slug = getTagSlug(tag);
                  const label = getTagLabel(tag);

                  return slug ? (
                    <a href={createTagUrl(tag)}>#{label}</a>
                  ) : (
                    <span>#{label}</span>
                  );
                })}
              </div>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .compact-posts {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px dashed rgb(212 212 212 / 0.72);
  }

  .compact-posts__item {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0.4rem;
    border-bottom: 1px dashed rgb(212 212 212 / 0.72);
    transition: background-color 160ms ease;
  }

  .compact-posts__item:hover {
    background: rgb(245 245 245 / 0.58);
  }

  .compact-posts time {
    padding-top: 0.15rem;
    color: rgb(163 163 163);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }

  .compact-posts__content {
    min-width: 0;
  }

  .compact-posts__title {
    color: rgb(38 38 38);
    font-size: 0.96rem;
    font-weight: 580;
    line-height: 1.55;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .compact-posts__title:hover {
    color: hsl(var(--primary));
  }

  .compact-posts__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin-top: 0.45rem;
    color: rgb(163 163 163);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .compact-posts__tags a {
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .compact-posts__tags a:hover {
    color: hsl(var(--primary));
  }

  .compact-posts a:focus-visible {
    border-radius: 2px;
    outline: 2px solid hsl(var(--primary) / 0.55);
    outline-offset: 3px;
  }

  :global(.dark) .compact-posts {
    border-color: rgb(82 82 82 / 0.7);
  }

  :global(.dark) .compact-posts__item {
    border-color: rgb(82 82 82 / 0.7);
  }

  :global(.dark) .compact-posts__item:hover {
    background: rgb(38 38 38 / 0.45);
  }

  :global(.dark) .compact-posts time,
  :global(.dark) .compact-posts__tags {
    color: rgb(115 115 115);
  }

  :global(.dark) .compact-posts__title {
    color: rgb(229 229 229);
  }

  :global(.dark) .compact-posts__title:hover,
  :global(.dark) .compact-posts__tags a:hover {
    color: hsl(var(--primary));
  }

  @media (max-width: 640px) {
    .compact-posts__item {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 0.65rem;
      padding-block: 0.9rem;
    }

    .compact-posts__title {
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .compact-posts__item,
    .compact-posts__title,
    .compact-posts__tags a {
      transition: none;
    }
  }
</style>
