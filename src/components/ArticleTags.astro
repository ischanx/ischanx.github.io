---
import {
  createTagUrl,
  getTagLabel,
  getTagSlug,
  normalizeTags,
} from '../utils/navigation';

interface Props {
  tags?: string[];
}

const { tags } = Astro.props;
const normalizedTags = normalizeTags(tags);
---

<div
  class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[13px] leading-6 text-neutral-500 dark:text-neutral-400 animate-slide-up"
>
  {
    normalizedTags.length > 0 && (
      <div
        class="flex flex-wrap gap-1.5 md:gap-2 animate-slide-up"
        style="animation-delay: 200ms;"
      >
        {normalizedTags.map((tag: string) => {
          const slug = getTagSlug(tag);
          const label = getTagLabel(tag);

          return slug ? (
            <a
              href={createTagUrl(tag)}
              class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200"
            >
              #{label}
            </a>
          ) : (
            <span class="text-neutral-500 dark:text-neutral-400">#{label}</span>
          );
        })}
      </div>
    )
  }
</div>
