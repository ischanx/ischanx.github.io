---
import {
  createTagUrl,
  getTagLabel,
  getTagSlug,
  normalizeTags,
} from '../utils/navigation';

interface Props {
  tags?: string[];
  wordCount: number;
  readTime: number;
}

const { tags, wordCount, readTime } = Astro.props;
const normalizedTags = normalizeTags(tags);
---

<div
  class="article-secondary-meta animate-slide-up"
  style="animation-delay: 200ms;"
>
  {
    normalizedTags.length > 0 && (
      <div
        class="article-tag-list"
      >
        {normalizedTags.map((tag: string) => {
          const slug = getTagSlug(tag);
          const label = getTagLabel(tag);

          return slug ? (
            <a
              href={createTagUrl(tag)}
              class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200"
            >
              #{label}
            </a>
          ) : (
            <span class="text-neutral-500 dark:text-neutral-400">#{label}</span>
          );
        })}
      </div>
    )
  }

  <div class="article-reading-stats">
    <span class="article-reading-stat">
      {wordCount} 字
    </span>
    <span class="article-reading-stat">
      {readTime} 分钟阅读
    </span>
  </div>
</div>

<style>
  @reference "../styles/global.css";

  .article-secondary-meta {
    @apply flex w-full flex-wrap items-center gap-x-4 gap-y-1.5 text-[13px] leading-6 text-neutral-500 dark:text-neutral-400;
    justify-content: space-between;
  }

  .article-tag-list,
  .article-reading-stats {
    @apply flex flex-wrap items-center gap-x-2 gap-y-1;
  }

  .article-reading-stats {
    @apply gap-x-2.5;
    margin-left: auto;
  }

  .article-reading-stat {
    @apply inline-flex items-center gap-1.5 whitespace-nowrap;
  }

  .article-reading-stat:not(:first-child)::before {
    @apply mr-0.5 text-neutral-300 dark:text-neutral-600;
    content: '·';
  }
</style>
