---
import type { CollectionEntry } from 'astro:content';
import CompactPostList from './CompactPostList.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  title?: string;
}

const { posts, title } = Astro.props;
---

<section class="post-list" aria-label={title ?? '文章列表'}>
  {
    title && (
      <header class="post-list__header">
        <h2>{title}</h2>
        <span aria-hidden="true" />
      </header>
    )
  }
  <CompactPostList posts={posts} />
</section>

<style>
  .post-list__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .post-list__header h2 {
    margin: 0;
    color: rgb(64 64 64);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: 0;
  }

  .post-list__header span {
    flex: 1;
    border-top: 1px solid rgb(229 229 229 / 0.8);
  }

  :global(.dark) .post-list__header h2 {
    color: rgb(212 212 212);
  }

  :global(.dark) .post-list__header span {
    border-color: rgb(82 82 82 / 0.75);
  }
</style>
