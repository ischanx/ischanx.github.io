</style>

<script>
  import { initializeArticleContent } from '../utils/article';

  const initialize = () => {
    const articleContent = document.getElementById('article-content');
    if (!articleContent || articleContent.dataset.enhanced === 'true') return;

    articleContent.dataset.enhanced = 'true';
    initializeArticleContent(articleContent).catch(error => {
      articleContent.dataset.enhanced = 'false';
      console.error('文章内容初始化失败:', error);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, { once: true });
  } else {
    initialize();
  }

  document.addEventListener('astro:page-load', initialize);
</script>
