---
/**
 * 文章目录(TOC)组件
 * 显示文章中的标题并支持滚动高亮
 * 支持多级标题显示，可根据配置决定显示的标题层级
 */

import ScrollArea from './ScrollArea.astro';

interface Props {
  /**
   * 最大显示的标题层级，默认为3
   * 例如：maxLevel=3 表示显示 h1, h2, h3
   */
  maxLevel?: number;
}

const { maxLevel = 3 } = Astro.props;
---

<div
  id="toc-container"
  class="z-50 hidden h-[calc(100vh-20rem)] lg:sticky lg:top-32 lg:block lg:w-12 lg:self-start"
  data-max-level={maxLevel}
>
  <ScrollArea
    class="h-full [--scroll-area-track-inset-bottom:2rem]"
    viewportClass="toc-content h-full px-2 pb-8"
    contentClass="toc-scroll-content"
  >
    <nav id="toc" class="toc-list" aria-label="文章目录">
      <div class="toc-skeleton" role="status" aria-label="正在加载文章目录">
        <span class="toc-skeleton-bar" style="--skeleton-width: 1.15rem;"></span>
        <span class="toc-skeleton-bar" style="--skeleton-width: 1.85rem;"></span>
        <span class="toc-skeleton-bar" style="--skeleton-width: 1.4rem;"></span>
        <span class="toc-skeleton-bar" style="--skeleton-width: 2.1rem;"></span>
        <span class="toc-skeleton-bar" style="--skeleton-width: 1.65rem;"></span>
      </div>
    </nav>
  </ScrollArea>

  <div id="toc-panel" class="toc-panel">
    <nav id="toc-text" class="toc-text-list" aria-label="文章目录文字列表"></nav>
  </div>
</div>

<script>
  // 存储滚动定时器的引用，以便清除
  let scrollTimeoutId: number | null = null;

  function handleTOC() {
    // 获取文章内容区域和TOC容器
    const articleContent = document.querySelector('.prose');
    const tocContainer = document.getElementById('toc-container');
    const tocList = document.getElementById('toc');
    const tocTextList = document.getElementById('toc-text');
    const tocPanel = document.getElementById('toc-panel');
    const initScrollAreas = (
      window as Window & { initScrollAreas?: () => void }
    ).initScrollAreas;

    if (
      !articleContent ||
      !tocContainer ||
      !tocList ||
      !tocTextList ||
      !tocPanel
    )
      return;

    // 将文字目录作为独立滚动区域，滚动到边界时不带动外层页面。
    if (tocPanel.dataset.scrollGuardReady !== 'true') {
      tocPanel.dataset.scrollGuardReady = 'true';
      tocPanel.addEventListener(
        'wheel',
        event => {
          const canScroll = tocPanel.scrollHeight > tocPanel.clientHeight;
          const atTop = tocPanel.scrollTop <= 0;
          const atBottom =
            Math.ceil(tocPanel.scrollTop + tocPanel.clientHeight) >=
            tocPanel.scrollHeight;

          if (
            !canScroll ||
            (event.deltaY < 0 && atTop) ||
            (event.deltaY > 0 && atBottom)
          ) {
            event.preventDefault();
          }
        },
        { passive: false }
      );
    }

    // 获取配置参数
    const maxLevel = parseInt(tocContainer.dataset.maxLevel || '3');

    // 构建标题选择器
    const headingSelectors = [];
    for (let i = 1; i <= maxLevel; i++) {
      headingSelectors.push(`h${i}`);
    }
    const headingSelector = headingSelectors.join(', ');

    // 获取文章中的所有标题元素
    const headings = articleContent.querySelectorAll(headingSelector);
    if (headings.length === 0) {
      tocContainer.classList.add('hidden');
      return;
    }
    const baseLevel = Math.min(
      ...Array.from(headings).map(heading =>
        parseInt(heading.tagName.substring(1))
      )
    );

    // 清空占位内容
    tocList.innerHTML = '';
    tocTextList.innerHTML = '';

    // 创建目录项
    const tocItems: Record<string, HTMLAnchorElement> = {};
    const tocTextItems: Record<string, HTMLAnchorElement> = {};

    // 创建类似代码 minimap 的条状目录
    headings.forEach(heading => {
      const id = heading.id;
      if (!id) return;

      const level = parseInt(heading.tagName.substring(1));
      if (level > maxLevel) return;

      // 去除标题中可能包含的锚点图标
      let text = heading.textContent || '';
      const anchorElement = heading.querySelector('.heading-anchor');
      if (anchorElement) {
        text = text.replace(anchorElement.textContent || '', '').trim();
      } else {
        text = text.replace(/§$/, '').trim();
      }

      if (!text) return;

      // 创建目录项
      const listItem = document.createElement('a');
      listItem.href = `#${id}`;
      const visualLevel = level - baseLevel + 1;
      listItem.classList.add('toc-item', `toc-level-${visualLevel}`);
      listItem.setAttribute('aria-label', text);
      listItem.title = text;

      const textIndent = Math.max(0, visualLevel - 1) * 0.75;
      const characterCount = Array.from(text).length;
      const minWidth = 0.7;
      const maxWidth = 2.15;
      const lengthRatio = Math.min(characterCount, 24) / 24;
      const barWidth = minWidth + (maxWidth - minWidth) * lengthRatio;

      listItem.style.setProperty('--toc-bar-width', `${barWidth}rem`);

      const bar = document.createElement('span');
      bar.className = 'toc-bar';
      bar.setAttribute('aria-hidden', 'true');

      const textItem = document.createElement('a');
      textItem.href = `#${id}`;
      textItem.classList.add(
        'toc-panel-item',
        `toc-panel-level-${visualLevel}`
      );
      textItem.style.setProperty('--toc-text-indent', `${textIndent}rem`);
      textItem.textContent = text;

      listItem.append(bar);
      tocList.appendChild(listItem);
      tocTextList.appendChild(textItem);
      tocItems[id] = listItem;
      tocTextItems[id] = textItem;
    });

    Object.values(tocItems)[0]?.classList.add('active');
    Object.values(tocTextItems)[0]?.classList.add('active');

    // 如果没有有效的目录项或者是移动设备，隐藏TOC
    if (Object.keys(tocItems).length === 0 || window.innerWidth < 768) {
      tocContainer.classList.add('hidden');
      return;
    }

    requestAnimationFrame(() => initScrollAreas?.());

    // 监听滚动，高亮当前可视区域的标题
    const observerOptions = {
      rootMargin: '-80px 0px -70% 0px',
      threshold: 0,
    };

    // 为window添加类型声明
    interface WindowWithObserver extends Window {
      tocHeadingObserver?: IntersectionObserver;
    }

    const windowWithObserver = window as WindowWithObserver;

    // 如果已存在旧的观察者，断开连接
    if (windowWithObserver.tocHeadingObserver) {
      windowWithObserver.tocHeadingObserver.disconnect();
    }

    let activeHeadingIds: string[] = [];
    // 标记是否是由用户点击目录项触发的滚动
    let isUserScrolling = false;

    const activateTocItem = (id: string) => {
      Object.values(tocItems).forEach(item => item.classList.remove('active'));
      Object.values(tocTextItems).forEach(item =>
        item.classList.remove('active')
      );
      tocItems[id]?.classList.add('active');
      tocTextItems[id]?.classList.add('active');
    };

    // 检查URL中是否有锚点，如果有则高亮对应的目录项
    const checkUrlHash = () => {
      const hash = window.location.hash;
      if (hash && hash.length > 1) {
        const id = hash.substring(1);
        const tocItem = tocItems[id];
        if (tocItem) {
          activateTocItem(id);

          // 将当前活动标题滚动到目录视图中
          const tocContainer = document.querySelector('.toc-content');
          if (tocContainer) {
            tocItem.scrollIntoView({
              behavior: 'smooth',
              block: 'center',
            });
            requestAnimationFrame(() => initScrollAreas?.());
          }
        }
      }
    };

    // 页面加载时检查URL锚点
    checkUrlHash();

    // 监听URL hash变化
    window.addEventListener('hashchange', checkUrlHash);

    windowWithObserver.tocHeadingObserver = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          const id = entry.target.id;
          const tocItem = tocItems[id];
          if (!tocItem) return;

          if (entry.isIntersecting) {
            activateTocItem(id);

            // 更新活动标题ID列表
            activeHeadingIds = [id];

            // 查找当前标题的所有父标题
            let currentElement = entry.target;
            let level = parseInt(currentElement.tagName.substring(1));

            while (level > 1) {
              // 查找上一级标题
              let prevLevel = level - 1;
              let prevHeading: Element | null = null;

              // 向前查找上一级标题
              let tempElement: Element | null = currentElement;
              while (tempElement && !prevHeading) {
                tempElement = tempElement.previousElementSibling;
                while (tempElement) {
                  const tagName = tempElement.tagName;
                  if (tagName && tagName.match(/^H[1-6]$/)) {
                    const headingLevel = parseInt(tagName.substring(1));
                    if (headingLevel === prevLevel) {
                      prevHeading = tempElement;
                      break;
                    } else if (headingLevel < prevLevel) {
                      // 如果找到更高级的标题，说明文档结构中缺少了某一级标题
                      break;
                    }
                  }
                  tempElement = tempElement.previousElementSibling;
                }

                if (!prevHeading && tempElement && tempElement.parentElement) {
                  tempElement = tempElement.parentElement;
                } else {
                  break;
                }
              }

              if (prevHeading && prevHeading.id) {
                activeHeadingIds.push(prevHeading.id);
                level = prevLevel;
              } else {
                break;
              }
            }

            // 将当前活动标题滚动到目录视图中，但不触发正文滚动
            if (tocItem) {
              // 获取目录容器
              const tocContainer = document.querySelector('.toc-content');
              if (tocContainer) {
                // 判断元素是否在视口内
                const rect = tocItem.getBoundingClientRect();
                const containerRect = tocContainer.getBoundingClientRect();

                // 检查元素是否在容器视口外
                const isOutOfView =
                  rect.top < containerRect.top ||
                  rect.bottom > containerRect.bottom;

                // 只有当元素不在视口内时才滚动
                if (isOutOfView) {
                  tocItem.scrollIntoView({
                    behavior: 'smooth',
                    block: 'center',
                  });
                  requestAnimationFrame(() => initScrollAreas?.());
                }
              }
            }
          }
        });
      },
      observerOptions
    );

    // 为每个标题添加观察者
    headings.forEach(heading => {
      if (heading.id && windowWithObserver.tocHeadingObserver) {
        windowWithObserver.tocHeadingObserver.observe(heading);
      }
    });

    // 点击TOC项时平滑滚动
    document
      .querySelectorAll('#toc .toc-item, #toc-text .toc-panel-item')
      .forEach(item => {
        item.addEventListener('click', e => {
          e.preventDefault();
          const id = item.getAttribute('href')?.substring(1);
          if (!id) return;

          const targetHeading = document.getElementById(id);
          if (!targetHeading) return;

          // 标记为用户点击触发的滚动
          isUserScrolling = true;

          window.scrollTo({
            top: targetHeading.offsetTop + 100,
            behavior: 'smooth',
          });

          // 更新URL，但不跳转
          history.pushState(null, '', `#${id}`);

          // 清除之前的定时器（如果存在）
          if (scrollTimeoutId !== null) {
            clearTimeout(scrollTimeoutId);
          }

          // 滚动完成后重置标记
          scrollTimeoutId = setTimeout(() => {
            isUserScrolling = false;
            scrollTimeoutId = null;
          }, 3000) as unknown as number; // 设置一个合理的延迟，确保滚动动画完成
        });
      });
  }

  // 页面加载完成后初始化TOC
  document.addEventListener('DOMContentLoaded', handleTOC);

  // 在内容可能变化时重新初始化TOC
  document.addEventListener('astro:page-load', handleTOC);
  document.addEventListener('astro:after-swap', handleTOC);
</script>

<style>
  #toc-container {
    --toc-bar: #e4e7eb;
    --toc-bar-hover: #bdc2c8;
    --toc-bar-active: #9298a0;
    --toc-panel-bg: rgb(248 250 252 / 0.98);
    --toc-panel-border: rgb(203 213 225 / 0.82);
    --toc-panel-text: #4b5563;
    --toc-panel-active-bg: rgb(226 232 240 / 0.72);
    --toc-panel-active-text: #20242b;
    overflow: visible;
  }

  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding-block: 0.25rem;
    width: 100%;
  }

  .toc-skeleton {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    width: 100%;
  }

  .toc-skeleton-bar {
    animation: toc-skeleton-pulse 1.6s ease-in-out infinite;
    background: var(--toc-bar);
    border-radius: 999px;
    display: block;
    height: 0.1875rem;
    margin-block: 0.46875rem;
    opacity: 0.65;
    width: min(var(--skeleton-width), 100%);
  }

  .toc-skeleton-bar:nth-child(2) {
    animation-delay: 80ms;
  }

  .toc-skeleton-bar:nth-child(3) {
    animation-delay: 160ms;
  }

  .toc-skeleton-bar:nth-child(4) {
    animation-delay: 240ms;
  }

  .toc-skeleton-bar:nth-child(5) {
    animation-delay: 320ms;
  }

  @keyframes toc-skeleton-pulse {
    0%,
    100% {
      opacity: 0.42;
    }
    50% {
      opacity: 0.78;
    }
  }

  :global(.dark) #toc-container {
    --toc-bar: #303236;
    --toc-bar-hover: #4e5258;
    --toc-bar-active: #747a82;
    --toc-panel-bg: rgb(30 30 30 / 0.98);
    --toc-panel-border: rgb(82 82 82 / 0.78);
    --toc-panel-text: #aeb4bc;
    --toc-panel-active-bg: rgb(64 64 64 / 0.58);
    --toc-panel-active-text: #d0d3d8;
  }

  :global(.toc-item) {
    --toc-bar-width: 1.5rem;
    align-items: center;
    display: flex;
    height: 1.125rem;
    outline: none;
    position: relative;
    width: 100%;
  }

  :global(.toc-bar) {
    background: var(--toc-bar);
    border-radius: 999px;
    display: block;
    height: 0.1875rem;
    transform-origin: left center;
    transition:
      background-color 160ms ease,
      height 160ms ease,
      transform 160ms ease;
    width: min(var(--toc-bar-width), 100%);
  }

  .toc-panel {
    background: var(--toc-panel-bg);
    border: 1px solid var(--toc-panel-border);
    border-radius: 0.5rem;
    box-shadow:
      0 12px 28px rgb(15 23 42 / 0.1),
      0 2px 8px rgb(15 23 42 / 0.06);
    left: 0;
    max-height: min(32rem, calc(100vh - 10rem));
    opacity: 0;
    overscroll-behavior-y: contain;
    overflow-y: auto;
    padding: 0.45rem;
    pointer-events: none;
    position: absolute;
    scrollbar-color: #aeb4bc transparent;
    scrollbar-width: thin;
    top: -0.5rem;
    transform: scale(0.985);
    transform-origin: left top;
    transition:
      opacity 150ms ease,
      transform 170ms ease,
      visibility 0s linear 170ms;
    visibility: hidden;
    width: clamp(18rem, 24vw, 22rem);
    z-index: 20;
  }

  :global(.dark) .toc-panel {
    box-shadow:
      0 16px 34px rgb(0 0 0 / 0.32),
      0 2px 8px rgb(0 0 0 / 0.2);
    scrollbar-color: #555b63 transparent;
  }

  #toc-container:hover .toc-panel,
  #toc-container:focus-within .toc-panel {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
    transition-delay: 0s;
    visibility: visible;
  }

  .toc-text-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  :global(.toc-panel-item) {
    border-inline-start: 2px solid transparent;
    border-radius: 0.3rem;
    color: var(--toc-panel-text);
    display: block;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    line-height: 1.35rem;
    padding: 0.2rem 0.5rem 0.2rem
      calc(0.5rem + var(--toc-text-indent, 0rem));
    transition:
      background-color 140ms ease,
      border-color 140ms ease,
      color 140ms ease;
  }

  :global(.toc-panel-level-1) {
    font-weight: 600;
  }

  :global(.toc-panel-item:hover),
  :global(.toc-panel-item:focus-visible) {
    background: var(--toc-panel-active-bg);
    color: var(--toc-panel-active-text);
    outline: none;
  }

  :global(.toc-panel-item.active) {
    background: var(--toc-panel-active-bg);
    border-inline-start-color: var(--toc-bar-active);
    color: var(--toc-panel-active-text);
    font-weight: 600;
  }

  #toc-container:hover :global(.toc-bar),
  #toc-container:focus-within :global(.toc-bar) {
    background: var(--toc-bar-hover);
  }

  :global(.toc-item.active .toc-bar) {
    background: var(--toc-bar-active);
  }

  :global(.toc-item:focus-visible .toc-bar) {
    box-shadow: 0 0 0 2px rgb(59 130 246 / 0.32);
  }

  :global(#toc-container .scroll-area__scrollbar) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-skeleton-bar,
    :global(.toc-bar),
    .toc-panel,
    :global(.toc-panel-item) {
      animation: none;
      transition: none;
    }
  }

  @media (max-width: 1023px) {
    #toc-container {
      display: none;
    }
  }
</style>
