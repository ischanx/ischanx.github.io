---
import type { CollectionEntry } from 'astro:content';
import { getPostUrl } from '../utils/route';
import {
  createTagUrl,
  getTagLabel,
  getTagSlug,
  normalizeTags,
} from '../utils/navigation';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const normalizedTags = normalizeTags(post.data.tags);
---

<div
  class="rounded-lg overflow-hidden border border-neutral-200 dark:border-neutral-700 shadow-sm hover:shadow-md transition-shadow"
>
  <div
    class="h-48 bg-neutral-200 dark:bg-neutral-700 flex items-center justify-center"
  >
    {
      post.data.image ? (
        <img
          src={post.data.image}
          alt={post.data.title}
          class="w-full h-full object-cover"
        />
      ) : (
        <div class="text-neutral-400 dark:text-neutral-500">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="48"
            height="48"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="m21 15-5-5L5 21" />
          </svg>
        </div>
      )
    }
  </div>
  <div class="p-6">
    <h3 class="text-2xl font-bold mb-4">
      <a href={getPostUrl(post)} class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
        {post.data.title}
      </a>
    </h3>
    <p class="text-neutral-600 dark:text-neutral-400 mb-4">
      {post.data.description || ''}
    </p>
    <div class="flex flex-wrap gap-2">
      {
        normalizedTags.map((tag: string) => {
          const slug = getTagSlug(tag);
          const label = getTagLabel(tag);
          const className = 'text-sm px-3 py-1 rounded-full bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-primary-50 dark:hover:bg-primary-950/40 hover:text-primary-700 dark:hover:text-primary-300 transition-colors';

          return slug ? (
            <a href={createTagUrl(tag)} class={className}>{label}</a>
          ) : (
            <span class={className}>{label}</span>
          );
        })
      }
    </div>
  </div>
</div>
