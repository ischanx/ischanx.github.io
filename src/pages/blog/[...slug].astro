---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostNavigation from '../../components/PostNavigation.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import ArticleTags from '../../components/ArticleTags.astro';
import ArticleContent from '../../components/ArticleContent.astro';
import StreamdownArticleBase from '../../components/article/StreamdownArticleBase';
import StreamdownArticleCode from '../../components/article/StreamdownArticleCode';
import StreamdownArticleRich from '../../components/article/StreamdownArticleRich';
import { site } from '../../config';
import { countWords, readingTime } from '../../utils/content';
import { getLastModifiedDateFromGit } from '../../utils/git';
import { getPostPath, getPostUrl } from '../../utils/route';
import {
  getCategoryLabel,
  getCategorySlugFromPost,
} from '../../utils/navigation';
import '../../styles/global.css';
import Giscus from '../../components/Giscus.astro';

export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    ({ data }: CollectionEntry<'blog'>) => {
      return !data.draft;
    }
  );

  // 按创建日期排序
  const sortedPosts = [...posts].sort((a, b) => {
    return b.data.createDate.getTime() - a.data.createDate.getTime();
  });

  return sortedPosts.map((post: CollectionEntry<'blog'>, index) => {
    const prevPost =
      index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null;
    const nextPost = index > 0 ? sortedPosts[index - 1] : null;

    // 使用公共工具函数获取文章路径
    const urlPath = getPostPath(post);

    return {
      params: { slug: urlPath },
      props: { post, prevPost, nextPost },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props as {
  post: CollectionEntry<'blog'>;
  prevPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
};
const {
  title,
  description,
  createDate,
  updateDate,
  author = site.author,
  tags,
} = post.data;
const categorySlug = getCategorySlugFromPost(post);
const category = post.data.category ?? getCategoryLabel(categorySlug);

// 获取原始Markdown内容
const rawContent = post.body ?? '';
const hasCodeFence = /^\s*(?:```|~~~)/m.test(rawContent);
const hasMermaid = /^\s*(?:```|~~~)mermaid(?:\s|$)/m.test(rawContent);
const hasMath = /(?:^|\n)\s*\$\$[\s\S]+?\$\$\s*(?:\n|$)/m.test(rawContent);
const hasTable = /^\s*\|.+\|\s*\n\s*\|(?:\s*:?-+:?\s*\|)+\s*$/m.test(
  rawContent
);
// 计算字数
const wordCount = countWords(rawContent);
// 计算阅读时间
const readTime = readingTime(rawContent);

// 如果没有设置 updateDate，尝试从 git 获取最后修改时间
let lastUpdateDate = updateDate;
if (!lastUpdateDate) {
  const contentFilePath = post.filePath ?? `src/content/blog/${post.id}.md`;
  const gitUpdateDate = getLastModifiedDateFromGit(contentFilePath);
  if (gitUpdateDate && gitUpdateDate > createDate) {
    lastUpdateDate = gitUpdateDate;
  }
}
---

<Layout
  title={title}
  description={description}
  markdownAlternate={`${getPostUrl(post)}.md`}
>
  <ReadingProgress />

  <div
    class="w-full max-w-4xl mx-auto px-4 animate-fade-in relative"
  >
    <div class="article-layout flex flex-col lg:grid">
      <TableOfContents />

      <!-- 主内容区 -->
      <article class="min-w-0 w-full">
        <ArticleHeader
          title={title}
          createDate={createDate}
          updateDate={lastUpdateDate}
          author={author}
          category={category}
          categorySlug={categorySlug}
          url={getPostUrl(post)}
          markdownUrl={`${getPostUrl(post)}.md`}
        />

        <ArticleTags tags={tags} wordCount={wordCount} readTime={readTime} />

        <ArticleContent>
          {
            hasMermaid || hasMath ? (
              <StreamdownArticleRich markdown={rawContent} client:idle />
            ) : hasCodeFence ? (
              <StreamdownArticleCode markdown={rawContent} client:idle />
            ) : hasTable ? (
              <StreamdownArticleBase markdown={rawContent} client:idle />
            ) : (
              <StreamdownArticleBase markdown={rawContent} />
            )
          }
        </ArticleContent>

        <!-- 文章导航 -->
        <PostNavigation prevPost={prevPost} nextPost={nextPost} />

        {
          site.comments.enabled &&
            site.comments.provider === 'giscus' && <Giscus />
        }
      </article>
    </div>
  </div>
</Layout>

<style>
  @media (min-width: 1024px) {
    .article-layout {
      grid-template-columns: 0 minmax(0, 1fr);
    }

    .article-layout :global(#toc-container) {
      margin-left: -4rem;
    }
  }
</style>
