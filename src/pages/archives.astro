---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import {
  createTagUrl,
  getTagLabel,
  getTagSlug,
  normalizeTags,
} from '../utils/navigation';
import { getPostUrl } from '../utils/route';
import { countWords } from '../utils/content';
import { site } from '../config';

type BlogPost = CollectionEntry<'blog'>;

// 获取所有非草稿文章
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// 按创建日期从新到旧排序
const posts = [...allPosts].sort(
  (a, b) =>
    new Date(b.data.createDate).getTime() -
    new Date(a.data.createDate).getTime()
);

// 计算统计数据
const totalPosts = posts.length;
const totalWords = posts.reduce((sum, post) => sum + countWords(post.body ?? ''), 0);

const formatHeatmapDate = (date: Date) =>
  date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });

// 计算博客运行时间
const startDate = new Date(site.footer.launchedAt);
const now = new Date();
const diffTime = Math.abs(now.getTime() - startDate.getTime());
const diffYears = Math.floor(diffTime / (1000 * 60 * 60 * 24 * 365));
const diffMonths = Math.floor((diffTime % (1000 * 60 * 60 * 24 * 365)) / (1000 * 60 * 60 * 24 * 30));
const diffDays = Math.floor((diffTime % (1000 * 60 * 60 * 24 * 30)) / (1000 * 60 * 60 * 24));

// 格式化运行时间
let runningTime = '';
if (diffYears > 0) {
  runningTime += `${diffYears} 年`;
  if (diffMonths > 0) {
    runningTime += ` ${diffMonths} 个月`;
  }
} else if (diffMonths > 0) {
  runningTime += `${diffMonths} 个月`;
  if (diffDays > 0) {
    runningTime += ` ${diffDays} 天`;
  }
} else {
  runningTime += `${diffDays} 天`;
}

const heatmapEndDate = new Date(now);
heatmapEndDate.setHours(0, 0, 0, 0);

// 生成最近约 5 年的文章周热力图数据
const heatmapWeekCount = 260;
const heatmapStartDate = new Date(heatmapEndDate);
heatmapStartDate.setDate(heatmapStartDate.getDate() - (heatmapWeekCount * 7 - 1));
heatmapStartDate.setHours(0, 0, 0, 0);

const archiveHeatmapWeeks = [];
for (let weekStart = new Date(heatmapStartDate); weekStart <= heatmapEndDate;) {
  const weekEnd = new Date(weekStart);
  weekEnd.setDate(weekStart.getDate() + 6);

  const rangeStart = weekStart;
  const rangeEnd = weekEnd > heatmapEndDate ? heatmapEndDate : weekEnd;
  const weekPosts = posts.filter(post => {
    const postDate = new Date(post.data.createDate);
    postDate.setHours(0, 0, 0, 0);
    return postDate >= rangeStart && postDate <= rangeEnd;
  });
  const count = weekPosts.length;
  const words = weekPosts.reduce((sum, post) => sum + countWords(post.body ?? ''), 0);

  archiveHeatmapWeeks.push({
    key: weekStart.toISOString(),
    count,
    words,
    level: 0,
    dateRange: `${formatHeatmapDate(rangeStart)} - ${formatHeatmapDate(rangeEnd)}`,
    label: `${formatHeatmapDate(rangeStart)} - ${formatHeatmapDate(rangeEnd)}：${count} 篇文章，${words.toLocaleString()} 字`,
    posts: weekPosts.map(post => ({
      title: post.data.title,
      url: getPostUrl(post),
    })),
  });

  weekStart.setDate(weekStart.getDate() + 7);
}

const maxWeeklyWords = Math.max(...archiveHeatmapWeeks.map(week => week.words), 0);
for (const week of archiveHeatmapWeeks) {
  week.level = week.words === 0
    ? 0
    : maxWeeklyWords === 0
      ? 1
      : Math.max(1, Math.ceil((week.words / maxWeeklyWords) * 4));
}

const heatmapStartYear = heatmapStartDate.getFullYear();
const heatmapEndYear = heatmapEndDate.getFullYear();

// 按年份和月份分组
type PostsByYearMonth = Record<number, Record<string, BlogPost[]>>;

const postsByYearMonth = posts.reduce((acc: PostsByYearMonth, post) => {
  const date = new Date(post.data.createDate);
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');

  if (!acc[year]) {
    acc[year] = {};
  }
  if (!acc[year][month]) {
    acc[year][month] = [];
  }
  acc[year][month].push(post);
  return acc;
}, {});

// 获取所有年份并排序
const years = Object.keys(postsByYearMonth)
  .map(Number)
  .sort((a, b) => b - a);
---

<Layout title="归档">
  <div class="archive-page">
    <header class="archive-intro">
      <h1 class="archive-title">写过的这些年</h1>
      <p class="archive-summary">
        从第一篇到现在，已经写了 <strong>{runningTime}</strong>
        <span aria-hidden="true">·</span>
        <strong>{totalPosts}</strong> 篇文章
        <span aria-hidden="true">·</span>
        <strong>{totalWords.toLocaleString()}</strong> 字
      </p>
    </header>

    <section class="archive-trace" aria-label="文章发布热力图">
      <p class="archive-trace__range">
        {heatmapStartYear} - {heatmapEndYear}
      </p>
      <div class="archive-heatmap-scroll">
        <div class="archive-heatmap-grid">
        {archiveHeatmapWeeks.map(week => (
          <button
            type="button"
            class="archive-heatmap-cell"
            data-level={week.level}
            aria-label={week.label}
            aria-hidden={week.count === 0 ? 'true' : undefined}
            tabindex={week.count === 0 ? -1 : 0}
            data-heatmap-cell
          >
            <template data-heatmap-tooltip>
              <div class="archive-tooltip">
                <div class="archive-tooltip__header">
                  <div class="archive-tooltip__date">
                  {week.dateRange}
                  </div>
                  <div class="archive-tooltip__words">
                  {week.words.toLocaleString()} 字
                  </div>
                </div>
                <div class="archive-tooltip__count">
                {week.count} 篇文章
                </div>
                <div class="archive-tooltip__posts">
                {week.posts.length > 0 ? (
                  week.posts.slice(0, 4).map(post => (
                    <a
                      href={post.url}
                      class="archive-tooltip__link"
                    >
                      {post.title}
                    </a>
                  ))
                ) : (
                  <div class="archive-tooltip__empty">
                    暂无文章
                  </div>
                )}
                {week.posts.length > 4 && (
                  <div class="archive-tooltip__more">
                    还有 {week.posts.length - 4} 篇
                  </div>
                )}
                </div>
              </div>
            </template>
          </button>
        ))}
        </div>
      </div>
    </section>

    <div class="archive-years">
      {
        years.map(year => {
          const months = Object.keys(postsByYearMonth[year]).sort((a, b) => b.localeCompare(a));
          const yearPosts = months.flatMap(month => postsByYearMonth[year][month]);

          return (
            <section class="archive-year" aria-labelledby={`archive-year-${year}`}>
              <header class="archive-year-heading">
                <h2 id={`archive-year-${year}`}>{year}</h2>
                <span>{yearPosts.length} 篇</span>
              </header>

              <ol class="archive-list">
                {yearPosts.map(post => {
                  const postDate = new Date(post.data.createDate);

                  return (
                    <li class="archive-entry">
                      <time
                        datetime={postDate.toISOString()}
                        class="archive-entry__date"
                      >
                        {String(postDate.getMonth() + 1).padStart(2, '0')}.{String(postDate.getDate()).padStart(2, '0')}
                      </time>
                      <div class="archive-entry__body">
                        <a href={getPostUrl(post)} class="archive-entry__title">
                          {post.data.title}
                        </a>

                        {normalizeTags(post.data.tags).length > 0 && (
                          <div class="archive-entry__tags">
                            {normalizeTags(post.data.tags).map((tag: string) => {
                              const slug = getTagSlug(tag);
                              const label = getTagLabel(tag);

                              return slug ? (
                                <a href={createTagUrl(tag)}>#{label}</a>
                              ) : (
                                <span>#{label}</span>
                              );
                            })}
                          </div>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ol>
            </section>
          );
        })
      }
    </div>
  </div>
</Layout>

<script>
  import tippy from 'tippy.js';
  import 'tippy.js/dist/tippy.css';

  const initializeArchiveHeatmap = () => {
    document.querySelectorAll<HTMLElement>('[data-heatmap-cell]').forEach((cell) => {
      if (cell.dataset.tooltipReady === 'true') {
        return;
      }

      const template = cell.querySelector('template[data-heatmap-tooltip]');

      if (!(template instanceof HTMLTemplateElement)) {
        return;
      }

      cell.dataset.tooltipReady = 'true';
      tippy(cell, {
        allowHTML: true,
        appendTo: document.body,
        content: template.innerHTML,
        delay: [80, 40],
        duration: [140, 100],
        interactive: true,
        maxWidth: 'none',
        offset: [0, 10],
        placement: 'top',
        theme: 'archive-heatmap',
        trigger: 'mouseenter focus',
      });
    });
  };

  initializeArchiveHeatmap();
  document.addEventListener('astro:page-load', initializeArchiveHeatmap);
</script>

<style is:global>
  .archive-page {
    --archive-ink: rgb(23 23 23);
    --archive-muted: rgb(115 115 115);
    --archive-faint: rgb(163 163 163);
    --archive-line: rgb(212 212 212 / 0.72);
    --archive-hover: rgb(245 245 245 / 0.62);
    width: min(100%, 56rem);
    margin-inline: auto;
    padding: 3.5rem 1rem 5rem;
    color: var(--archive-ink);
  }

  .dark .archive-page {
    --archive-ink: rgb(229 229 229);
    --archive-muted: rgb(163 163 163);
    --archive-faint: rgb(115 115 115);
    --archive-line: rgb(82 82 82 / 0.64);
    --archive-hover: rgb(38 38 38 / 0.5);
  }

  .archive-intro {
    max-width: 42rem;
    margin-bottom: 3.75rem;
  }

  .archive-title {
    position: relative;
    display: inline-block;
    margin: 0;
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .archive-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.55rem;
    margin: 1.35rem 0 0;
    color: var(--archive-muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .archive-summary strong {
    color: var(--archive-ink);
    font-weight: 600;
  }

  .archive-trace {
    margin-bottom: 4.25rem;
  }

  .archive-year-heading {
    display: flex;
    align-items: center;
  }

  .archive-trace__range {
    color: var(--archive-faint);
    font-size: 0.72rem;
    margin: 0 0 1rem;
    text-align: right;
  }

  .archive-heatmap-scroll {
    overflow-x: auto;
    padding: 0.2rem 0 0.45rem;
    scrollbar-width: thin;
    scrollbar-color: var(--archive-line) transparent;
  }

  .archive-heatmap-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(5, minmax(0, 1fr));
    grid-template-columns: repeat(52, minmax(0.55rem, 1fr));
    gap: 0.22rem;
    min-width: 36rem;
  }

  .archive-heatmap-cell {
    aspect-ratio: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 2px;
    appearance: none;
    background: rgb(229 229 229 / 0.72);
    cursor: default;
    transition: background-color 150ms ease, box-shadow 150ms ease;
  }

  .dark .archive-heatmap-cell {
    background: rgb(64 64 64 / 0.7);
  }

  .archive-heatmap-cell[data-level='1'] {
    background: hsl(var(--primary) / 0.16);
  }

  .archive-heatmap-cell[data-level='2'] {
    background: hsl(var(--primary) / 0.3);
  }

  .archive-heatmap-cell[data-level='3'] {
    background: hsl(var(--primary) / 0.55);
  }

  .archive-heatmap-cell[data-level='4'] {
    background: hsl(var(--primary) / 0.78);
  }

  .dark .archive-heatmap-cell[data-level='1'] {
    background: hsl(var(--primary) / 0.2);
  }

  .dark .archive-heatmap-cell[data-level='2'] {
    background: hsl(var(--primary) / 0.38);
  }

  .dark .archive-heatmap-cell[data-level='3'] {
    background: hsl(var(--primary) / 0.64);
  }

  .dark .archive-heatmap-cell[data-level='4'] {
    background: hsl(var(--primary) / 0.88);
  }

  .archive-heatmap-cell:hover {
    box-shadow: 0 0 0 2px hsl(var(--primary) / 0.32);
  }

  .archive-heatmap-cell:focus-visible {
    position: relative;
    z-index: 1;
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
  }

  .archive-years {
    display: grid;
    gap: 4rem;
  }

  .archive-year-heading {
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }

  .archive-year-heading h2 {
    position: relative;
    margin: 0;
    font-size: 1.85rem;
    font-weight: 720;
    line-height: 1;
    letter-spacing: 0;
  }

  .archive-year-heading span {
    color: var(--archive-faint);
    font-size: 0.72rem;
  }

  .archive-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .archive-entry {
    display: grid;
    grid-template-columns: 3.7rem minmax(0, 1fr);
    gap: 0.85rem;
    padding: 0.9rem 0.45rem;
    border-bottom: 1px dashed var(--archive-line);
    transition: background-color 150ms ease;
  }

  .archive-entry:hover {
    background: var(--archive-hover);
  }

  .archive-entry__date {
    padding-top: 0.15rem;
    color: var(--archive-faint);
    font-variant-numeric: tabular-nums;
    font-size: 0.73rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .archive-entry__body {
    min-width: 0;
  }

  .archive-entry__title {
    color: var(--archive-ink);
    font-size: 1rem;
    font-weight: 580;
    line-height: 1.5;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .archive-entry__title:hover,
  .archive-entry__title:focus-visible,
  .archive-entry__tags a:hover,
  .archive-entry__tags a:focus-visible {
    color: hsl(var(--primary));
  }

  .dark .archive-entry__title:hover,
  .dark .archive-entry__title:focus-visible,
  .dark .archive-entry__tags a:hover,
  .dark .archive-entry__tags a:focus-visible {
    color: hsl(var(--primary));
  }

  .archive-entry__title:focus-visible,
  .archive-entry__tags a:focus-visible {
    border-radius: 2px;
    outline: 2px solid hsl(var(--primary) / 0.72);
    outline-offset: 3px;
  }

  .archive-entry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.65rem;
    margin-top: 0.28rem;
    color: var(--archive-faint);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .archive-entry__tags a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .archive-tooltip {
    width: 18rem;
    overflow: hidden;
    border: 1px solid rgb(229 229 229);
    border-radius: 6px;
    background: rgb(255 255 255);
    color: rgb(64 64 64);
    text-align: left;
    box-shadow: 0 14px 38px rgb(23 23 23 / 0.14);
  }

  .dark .archive-tooltip {
    border-color: rgb(64 64 64);
    background: rgb(23 23 23);
    color: rgb(212 212 212);
    box-shadow: 0 14px 38px rgb(0 0 0 / 0.38);
  }

  .archive-tooltip__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem 0.45rem;
  }

  .archive-tooltip__date {
    min-width: 0;
    overflow: hidden;
    font-size: 0.7rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .archive-tooltip__words,
  .archive-tooltip__count,
  .archive-tooltip__more {
    color: rgb(115 115 115);
    font-size: 0.65rem;
  }

  .archive-tooltip__words {
    flex-shrink: 0;
  }

  .archive-tooltip__count {
    padding: 0 0.75rem 0.5rem;
    border-bottom: 1px solid rgb(229 229 229);
  }

  .dark .archive-tooltip__count {
    border-color: rgb(64 64 64);
  }

  .archive-tooltip__posts {
    padding: 0.55rem 0.75rem 0.65rem;
  }

  .archive-tooltip__link {
    display: block;
    overflow: hidden;
    padding-block: 0.15rem;
    color: inherit;
    font-size: 0.72rem;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .archive-tooltip__link:hover {
    color: hsl(var(--primary));
  }

  .dark .archive-tooltip__link:hover {
    color: hsl(var(--primary));
  }

  .archive-tooltip__empty {
    color: rgb(163 163 163);
    font-size: 0.72rem;
  }

  .archive-tooltip__more {
    margin-top: 0.25rem;
  }

  .tippy-box[data-theme~='archive-heatmap'] {
    background: transparent;
    border-radius: 0;
    box-shadow: none;
    color: inherit;
  }

  .tippy-box[data-theme~='archive-heatmap'] > .tippy-content {
    padding: 0;
  }

  .tippy-box[data-theme~='archive-heatmap'] > .tippy-arrow {
    color: rgb(255 255 255);
  }

  .dark .tippy-box[data-theme~='archive-heatmap'] > .tippy-arrow {
    color: rgb(23 23 23);
  }

  @media (max-width: 640px) {
    .archive-page {
      padding: 2.5rem 0.75rem 4rem;
    }

    .archive-intro {
      margin-bottom: 3rem;
    }

    .archive-title {
      font-size: 2rem;
    }

    .archive-summary {
      gap: 0.15rem 0.42rem;
      font-size: 0.82rem;
    }

    .archive-trace {
      margin-bottom: 3.4rem;
    }

    .archive-years {
      gap: 3.25rem;
    }

    .archive-entry {
      grid-template-columns: 3.15rem minmax(0, 1fr);
      gap: 0.6rem;
      padding-inline: 0.15rem;
    }

    .archive-entry__title {
      font-size: 0.94rem;
    }

    .archive-tooltip {
      width: min(18rem, calc(100vw - 1.5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-heatmap-cell,
    .archive-entry,
    .archive-entry__title,
    .archive-entry__tags a {
      transition: none;
    }
  }
</style>
