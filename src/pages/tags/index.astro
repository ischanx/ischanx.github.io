---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { site } from '../../config';
import { getTagLabel, getTagSlug } from '../../utils/navigation';

type BlogPost = Awaited<ReturnType<typeof getCollection<'blog'>>>[number];

const posts = await getCollection('blog', ({ data }) => !data.draft);
const tagPosts = new Map<string, { name: string; posts: BlogPost[] }>();

posts.forEach((post: BlogPost) => {
  post.data.tags?.forEach(rawTag => {
    if (!rawTag.trim()) return;

    const slug = getTagSlug(rawTag);
    if (!slug) return;
    const current = tagPosts.get(slug) ?? {
      name: getTagLabel(slug),
      posts: [],
    };
    if (!current.posts.some(currentPost => currentPost.id === post.id)) {
      current.posts.push(post);
    }
    tagPosts.set(slug, current);
  });
});

const tags = [...tagPosts.entries()]
  .map(([slug, tag]) => {
    return {
      slug,
      name: tag.name,
      count: tag.posts.length,
    };
  })
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN'));
---

<Layout
  title="文章标签"
  description={`按标签浏览 ${site.title} 中的技术文章与实践记录。`}
>
  <div class="mx-auto max-w-6xl px-4 py-8 md:py-12">
    <header class="mb-8 md:mb-10">
      <p class="mb-2 text-sm font-medium text-primary-600 dark:text-primary-400">
        Browse by tag
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        文章标签
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-neutral-600 dark:text-neutral-400">
        用更细的主题标签，快速找到相近的文章与实践。
      </p>
      <p class="mt-4 text-xs text-neutral-500 dark:text-neutral-500">
        共 {tags.length} 个标签
      </p>
    </header>

    <nav aria-label="文章标签列表">
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
        {
          tags.map(tag => (
            <a
              href={`/tags/${tag.slug}`}
              class="group flex min-h-14 items-center justify-between gap-2 rounded-lg border border-neutral-200 bg-white/70 px-3.5 py-3 transition-colors hover:border-primary-300 hover:bg-primary-50/60 dark:border-neutral-800 dark:bg-neutral-900/55 dark:hover:border-primary-700 dark:hover:bg-primary-950/20"
            >
              <span class="min-w-0 break-words text-sm font-medium text-neutral-800 transition-colors group-hover:text-primary-600 dark:text-neutral-200 dark:group-hover:text-primary-400">
                #{tag.name}
              </span>
              <span class="shrink-0 text-xs tabular-nums text-neutral-500 dark:text-neutral-500">
                {tag.count}
              </span>
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</Layout>
