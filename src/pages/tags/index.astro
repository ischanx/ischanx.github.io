---
import Layout from '../../layouts/Layout.astro';
import JournalPage from '../../components/JournalPage.astro';
import { getCollection } from 'astro:content';
import { site } from '../../config';
import { getTagLabel, getTagSlug } from '../../utils/navigation';

type BlogPost = Awaited<ReturnType<typeof getCollection<'blog'>>>[number];

const posts = await getCollection('blog', ({ data }) => !data.draft);
const tagPosts = new Map<string, { name: string; posts: BlogPost[] }>();

posts.forEach((post: BlogPost) => {
  post.data.tags?.forEach(rawTag => {
    if (!rawTag.trim()) return;

    const slug = getTagSlug(rawTag);
    if (!slug) return;
    const current = tagPosts.get(slug) ?? {
      name: getTagLabel(slug),
      posts: [],
    };
    if (!current.posts.some(currentPost => currentPost.id === post.id)) {
      current.posts.push(post);
    }
    tagPosts.set(slug, current);
  });
});

const tags = [...tagPosts.entries()]
  .map(([slug, tag]) => {
    return {
      slug,
      name: tag.name,
      count: tag.posts.length,
    };
  })
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN'));
---

<Layout
  title="文章标签"
  description={`按标签浏览 ${site.title} 中的技术文章与实践记录。`}
>
  <JournalPage
    title="从关键词开始"
    description="一些反复出现的方向，也是一份随手记下的内容索引。"
    backgroundImage="/img/page-heroes/tags.webp"
    backgroundPosition="center 54%"
  >
    <p slot="meta" class="tag-count">共 {tags.length} 个标签</p>

    <nav class="tag-index" aria-label="文章标签列表">
      <div class="tag-index__words">
        {
          tags.map(tag => (
            <a
              href={`/tags/${tag.slug}`}
              class="tag-index__word"
            >
              <span>
                #{tag.name}
              </span>
              <small>
                {tag.count}
              </small>
            </a>
          ))
        }
      </div>
    </nav>
  </JournalPage>
</Layout>

<style>
  .tag-count {
    margin: 1rem 0 0;
    color: rgb(163 163 163);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .tag-index {
    padding: 0.3rem 0.4rem;
  }

  .tag-index__words {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1.1rem 1.75rem;
  }

  .tag-index__word {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    color: rgb(64 64 64);
    font-size: 0.92rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .tag-index__word span {
    text-decoration: none;
  }

  .tag-index__word small {
    color: rgb(163 163 163);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }

  .tag-index__word:hover {
    color: hsl(var(--primary));
  }

  .tag-index__word:focus-visible {
    border-radius: 2px;
    outline: 2px solid hsl(var(--primary) / 0.55);
    outline-offset: 4px;
  }

  :global(.dark) .tag-count,
  :global(.dark) .tag-index__word small {
    color: rgb(115 115 115);
  }

  :global(.dark) .tag-index__word {
    color: rgb(212 212 212);
  }

  :global(.dark) .tag-index__word:hover {
    color: hsl(var(--primary));
  }

  @media (max-width: 640px) {
    .tag-index {
      padding-block: 0.2rem;
    }

    .tag-index__words {
      gap: 0.95rem 1.25rem;
    }

    .tag-index__word {
      font-size: 0.84rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-index__word {
      transition: none;
    }
  }
</style>
