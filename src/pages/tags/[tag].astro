---
import Layout from '../../layouts/Layout.astro';
import JournalPage from '../../components/JournalPage.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import {
  createTagUrl,
  getTagLabel,
  getTagSlug,
} from '../../utils/navigation';
import { site } from '../../config';

type BlogPost = CollectionEntry<'blog'>;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tagSlugs = [
    ...new Set(
      posts
        .flatMap(post => post.data.tags || [])
        .filter((tag): tag is string => tag.trim().length > 0)
        .map(getTagSlug)
        .filter((slug): slug is string => Boolean(slug))
    ),
  ];

  return tagSlugs.map(slug => ({
    params: { tag: slug },
    props: {
      tagSlug: slug,
      tag: getTagLabel(slug),
      posts: posts
        .filter(post =>
          post.data.tags?.some(rawTag => getTagSlug(rawTag) === slug)
        )
        .sort(
          (a, b) =>
            b.data.createDate.getTime() - a.data.createDate.getTime()
        ),
    },
  }));
}

const { tag, tagSlug, posts } = Astro.props as {
  tag: string;
  tagSlug: string;
  posts: BlogPost[];
};
const tagUrl = createTagUrl(tagSlug);
---

<Layout
  title={`#${tag} - 文章标签`}
  description={`浏览 ${site.title} 中「${tag}」标签下的全部文章。`}
  canonical={`${site.url}${tagUrl}`}
>
  <JournalPage
    title={`#${tag}`}
    description="从一个关键词出发，把散落在不同主题里的文章串起来。"
  >
    <nav
      slot="before"
      aria-label="面包屑"
      class="journal-breadcrumb"
    >
      <a href="/">首页</a>
      <span aria-hidden="true">/</span>
      <a href="/tags">标签</a>
    </nav>

    <p slot="meta" class="journal-count">
        共 {posts.length} 篇文章
    </p>

    <PostList posts={posts} />
  </JournalPage>
</Layout>

<style>
  .journal-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 2.5rem;
    color: rgb(163 163 163);
    font-size: 0.75rem;
  }

  .journal-breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .journal-breadcrumb a:hover {
    color: hsl(var(--primary));
  }

  .journal-breadcrumb a:focus-visible {
    border-radius: 2px;
    outline: 2px solid hsl(var(--primary) / 0.55);
    outline-offset: 3px;
  }

  .journal-count {
    margin: 1rem 0 0;
    color: rgb(163 163 163);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  :global(.dark) .journal-breadcrumb,
  :global(.dark) .journal-count {
    color: rgb(115 115 115);
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-breadcrumb a {
      transition: none;
    }
  }
</style>
