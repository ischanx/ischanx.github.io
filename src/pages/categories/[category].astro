---
import Layout from '../../layouts/Layout.astro';
import JournalPage from '../../components/JournalPage.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import {
  createCategoryUrl,
  getCategoryLabel,
  getCategorySlugFromPost,
} from '../../utils/navigation';
import { site } from '../../config';

type BlogPost = CollectionEntry<'blog'>;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = new Map<string, { name: string; posts: BlogPost[] }>();
  for (const post of posts) {
    const slug = getCategorySlugFromPost(post);
    const current = categories.get(slug) ?? {
      name: getCategoryLabel(slug),
      posts: [],
    };
    current.posts.push(post);
    categories.set(slug, current);
  }

  return [...categories.entries()].map(([slug, category]) => ({
    params: { category: slug },
    props: {
      category: category.name,
      categorySlug: slug,
      posts: category.posts.sort(
        (a, b) => b.data.createDate.getTime() - a.data.createDate.getTime()
      ),
    },
  }));
}

const { category, categorySlug, posts } = Astro.props as {
  category: string;
  categorySlug: string;
  posts: BlogPost[];
};
const categoryUrl = createCategoryUrl(categorySlug);
---

<Layout
  title={`${category} - 文章分类`}
  description={`浏览 ${site.title} 中「${category}」分类下的全部文章。`}
  canonical={`${site.url}${categoryUrl}`}
>
  <JournalPage
    title={category}
    description="沿着同一个主题，继续往下翻。"
  >
    <nav
      slot="before"
      aria-label="面包屑"
      class="journal-breadcrumb"
    >
      <a href="/">首页</a>
      <span aria-hidden="true">/</span>
      <a href="/categories">分类</a>
    </nav>

    <p slot="meta" class="journal-count">
        共 {posts.length} 篇文章
    </p>

    <PostList posts={posts} />
  </JournalPage>
</Layout>

<style>
  .journal-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 2.5rem;
    color: rgb(163 163 163);
    font-size: 0.75rem;
  }

  .journal-breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .journal-breadcrumb a:hover {
    color: hsl(var(--primary));
  }

  .journal-breadcrumb a:focus-visible {
    border-radius: 2px;
    outline: 2px solid hsl(var(--primary) / 0.55);
    outline-offset: 3px;
  }

  .journal-count {
    margin: 1rem 0 0;
    color: rgb(163 163 163);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  :global(.dark) .journal-breadcrumb,
  :global(.dark) .journal-count {
    color: rgb(115 115 115);
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-breadcrumb a {
      transition: none;
    }
  }
</style>
