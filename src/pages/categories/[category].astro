---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import {
  createCategoryUrl,
  getCategoryLabel,
  getCategorySlugFromPost,
} from '../../utils/navigation';
import { site } from '../../config';

type BlogPost = CollectionEntry<'blog'>;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = new Map<string, { name: string; posts: BlogPost[] }>();
  for (const post of posts) {
    const slug = getCategorySlugFromPost(post);
    const current = categories.get(slug) ?? {
      name: getCategoryLabel(slug),
      posts: [],
    };
    current.posts.push(post);
    categories.set(slug, current);
  }

  return [...categories.entries()].map(([slug, category]) => ({
    params: { category: slug },
    props: {
      category: category.name,
      categorySlug: slug,
      posts: category.posts.sort(
        (a, b) => b.data.createDate.getTime() - a.data.createDate.getTime()
      ),
    },
  }));
}

const { category, categorySlug, posts } = Astro.props as {
  category: string;
  categorySlug: string;
  posts: BlogPost[];
};
const categoryUrl = createCategoryUrl(categorySlug);
---

<Layout
  title={`${category} - 文章分类`}
  description={`浏览 ${site.title} 中「${category}」分类下的全部文章。`}
  canonical={`${site.url}${categoryUrl}`}
>
  <div class="mx-auto max-w-4xl px-4 py-8 md:py-12">
    <nav
      aria-label="面包屑"
      class="flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400"
    >
      <a
        href="/"
        class="transition-colors hover:text-primary-600 dark:hover:text-primary-400"
      >首页</a>
      <span aria-hidden="true" class="text-neutral-300 dark:text-neutral-700">/</span>
      <a
        href="/categories"
        class="transition-colors hover:text-primary-600 dark:hover:text-primary-400"
      >分类</a>
      <span aria-hidden="true" class="text-neutral-300 dark:text-neutral-700">/</span>
      <span class="font-medium text-neutral-700 dark:text-neutral-200" aria-current="page">
        {category}
      </span>
    </nav>

    <header class="mb-8 mt-8 md:mb-10">
      <p class="mb-2 text-sm font-medium text-primary-600 dark:text-primary-400">
        Article category
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        {category}
      </h1>
      <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">
        共 {posts.length} 篇文章
      </p>
    </header>

    <PostList posts={posts} />
  </div>
</Layout>
