---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categoryDescriptions, site } from '../../config';
import {
  createCategoryUrl,
  getCategoryLabel,
  getCategorySlugFromPost,
} from '../../utils/navigation';
import { getPostUrl } from '../../utils/route';

type BlogPost = Awaited<ReturnType<typeof getCollection<'blog'>>>[number];

const posts = await getCollection('blog', ({ data }) => !data.draft);
const categoryPosts = new Map<string, { name: string; posts: BlogPost[] }>();

posts.forEach((post: BlogPost) => {
  const slug = getCategorySlugFromPost(post);
  const current = categoryPosts.get(slug) ?? {
    name: getCategoryLabel(slug),
    posts: [],
  };
  current.posts.push(post);
  categoryPosts.set(slug, current);
});

const categories = [...categoryPosts.entries()]
  .map(([slug, category]) => {
    const sortedPosts = [...category.posts].sort(
      (a, b) => b.data.createDate.getTime() - a.data.createDate.getTime()
    );

    return {
      slug,
      name: category.name,
      count: sortedPosts.length,
      description:
        categoryDescriptions[slug] ?? '浏览这个分类下的全部文章。',
      previewPosts: sortedPosts.slice(0, 5),
    };
  })
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN'));
---

<Layout
  title="文章分类"
  description={`按分类浏览 ${site.title} 中的技术文章与实践记录。`}
>
  <div class="mx-auto max-w-6xl px-4 py-8 md:py-12">
    <header class="mb-8 md:mb-10">
      <p class="mb-2 text-sm font-medium text-primary-600 dark:text-primary-400">
        Browse by category
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        文章分类
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-neutral-600 dark:text-neutral-400">
        按主题浏览文章，找到相近的实践、拆解与思考。
      </p>
    </header>

    <nav aria-label="文章分类列表">
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        {
          categories.map(category => (
            <section class="overflow-hidden rounded-xl border border-neutral-200 bg-white/70 dark:border-neutral-800 dark:bg-neutral-900/55">
              <a
                href={createCategoryUrl(category.slug)}
                class="group flex items-start justify-between gap-4 border-b border-neutral-200 px-5 py-4 transition-colors hover:bg-primary-50/60 dark:border-neutral-800 dark:hover:bg-primary-950/20"
              >
                <span class="min-w-0">
                  <span class="block text-xl font-semibold text-neutral-900 transition-colors group-hover:text-primary-600 dark:text-neutral-100 dark:group-hover:text-primary-400">
                    {category.name}
                  </span>
                  <span class="mt-1 block text-sm leading-6 text-neutral-600 dark:text-neutral-400">
                    {category.description}
                  </span>
                </span>
                <span class="shrink-0 text-sm font-medium text-neutral-500 dark:text-neutral-400">
                  {category.count} 篇
                </span>
              </a>

              <ul class="divide-y divide-neutral-200 dark:divide-neutral-800">
                {
                  category.previewPosts.map(post => (
                    <li>
                      <a
                        href={getPostUrl(post)}
                        class="group flex items-center gap-3 px-5 py-3 transition-colors hover:bg-neutral-50 dark:hover:bg-neutral-900"
                      >
                        <span class="min-w-0 flex-1 truncate text-sm text-neutral-700 transition-colors group-hover:text-primary-600 dark:text-neutral-300 dark:group-hover:text-primary-400">
                          {post.data.title}
                        </span>
                        <time
                          datetime={post.data.createDate.toISOString()}
                          class="shrink-0 text-xs text-neutral-500 dark:text-neutral-500"
                        >
                          {post.data.createDate.toLocaleDateString('zh-CN', {
                            year: 'numeric',
                            month: '2-digit',
                            day: '2-digit',
                          })}
                        </time>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </section>
          ))
        }
      </div>
    </nav>
  </div>
</Layout>
