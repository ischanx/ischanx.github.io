---
import Layout from '../../layouts/Layout.astro';
import JournalPage from '../../components/JournalPage.astro';
import { getCollection } from 'astro:content';
import { categoryDescriptions, site } from '../../config';
import {
  createCategoryUrl,
  getCategoryLabel,
  getCategorySlugFromPost,
} from '../../utils/navigation';
import { getPostUrl } from '../../utils/route';

type BlogPost = Awaited<ReturnType<typeof getCollection<'blog'>>>[number];

const posts = await getCollection('blog', ({ data }) => !data.draft);
const categoryPosts = new Map<string, { name: string; posts: BlogPost[] }>();

posts.forEach((post: BlogPost) => {
  const slug = getCategorySlugFromPost(post);
  const current = categoryPosts.get(slug) ?? {
    name: getCategoryLabel(slug),
    posts: [],
  };
  current.posts.push(post);
  categoryPosts.set(slug, current);
});

const categories = [...categoryPosts.entries()]
  .map(([slug, category]) => {
    const sortedPosts = [...category.posts].sort(
      (a, b) => b.data.createDate.getTime() - a.data.createDate.getTime()
    );

    return {
      slug,
      name: category.name,
      count: sortedPosts.length,
      description:
        categoryDescriptions[slug] ?? '浏览这个分类下的全部文章。',
      previewPosts: sortedPosts.slice(0, 5),
    };
  })
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN'));
---

<Layout
  title="文章分类"
  description={`按分类浏览 ${site.title} 中的技术文章与实践记录。`}
>
  <JournalPage
    title="按主题翻一翻"
    description="像翻书架一样，从一个方向开始，看看沿途写下的实践与思考。"
  >
    <nav class="category-shelf" aria-label="文章分类列表">
      <div class="category-shelf__grid">
        {
          categories.map(category => (
            <section class="category-section">
              <a
                href={createCategoryUrl(category.slug)}
                class="category-section__heading"
              >
                <span class="category-section__copy">
                  <span class="category-section__title">
                    {category.name}
                  </span>
                  <span class="category-section__description">
                    {category.description}
                  </span>
                </span>
                <span class="category-section__count">
                  {category.count} 篇
                </span>
              </a>

              <ul class="category-section__posts">
                {
                  category.previewPosts.map(post => (
                    <li>
                      <a
                        href={getPostUrl(post)}
                        class="category-section__post"
                      >
                        <span>
                          {post.data.title}
                        </span>
                        <time
                          datetime={post.data.createDate.toISOString()}
                        >
                          {post.data.createDate.toLocaleDateString('zh-CN', {
                            month: '2-digit',
                            day: '2-digit',
                          })}
                        </time>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </section>
          ))
        }
      </div>
    </nav>
  </JournalPage>
</Layout>

<style>
  .category-shelf__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.5rem 3rem;
  }

  .category-section {
    min-width: 0;
  }

  .category-section__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 0.35rem 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  .category-section__copy {
    min-width: 0;
  }

  .category-section__title {
    display: inline-block;
    position: relative;
    color: rgb(38 38 38);
    font-size: 1.15rem;
    font-weight: 680;
    line-height: 1.4;
    transition: color 160ms ease;
  }

  .category-section__heading:hover .category-section__title {
    color: hsl(var(--primary));
  }

  .category-section__description {
    display: block;
    margin-top: 0.65rem;
    color: rgb(115 115 115);
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .category-section__count {
    flex: none;
    padding-top: 0.18rem;
    color: rgb(163 163 163);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  .category-section__posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-section__post {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.72rem 0.35rem;
    border-top: 1px dashed rgb(229 229 229 / 0.78);
    color: rgb(82 82 82);
    font-size: 0.82rem;
    line-height: 1.5;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .category-section__post span {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .category-section__post time {
    flex: none;
    color: rgb(163 163 163);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .category-section__post:hover {
    color: hsl(var(--primary));
    background: rgb(245 245 245 / 0.52);
  }

  .category-section a:focus-visible {
    border-radius: 2px;
    outline: 2px solid hsl(var(--primary) / 0.55);
    outline-offset: 3px;
  }

  :global(.dark) .category-section {
    border-color: rgb(82 82 82 / 0.7);
  }

  :global(.dark) .category-section__title {
    color: rgb(229 229 229);
  }

  :global(.dark) .category-section__description,
  :global(.dark) .category-section__post {
    color: rgb(163 163 163);
  }

  :global(.dark) .category-section__post {
    border-color: rgb(64 64 64 / 0.75);
  }

  :global(.dark) .category-section__post:hover {
    color: hsl(var(--primary));
    background: rgb(38 38 38 / 0.42);
  }

  @media (max-width: 720px) {
    .category-shelf__grid {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-section__title,
    .category-section__post {
      transition: none;
    }
  }
</style>
