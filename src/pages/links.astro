---
import Layout from '../layouts/Layout.astro';
import JournalPage from '../components/JournalPage.astro';
import { links, site } from '../config';
---

<Layout
  title="友链"
  description={`浏览 ${site.title} 推荐的博客与个人站点。`}
>
  <JournalPage
    title="友链"
    description="一些常去串门的博客与个人站点，像一本慢慢写满的通讯录。"
  >
    <section class="friend-directory" aria-label="友链列表">
      {
        links.items.length > 0 ? (
          <ul class="friend-list">
            {links.items.map(link => (
              <li>
                <a
                  href={link.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="friend-link"
                  aria-label={`访问 ${link.title} 的博客`}
                >
                  <img
                    src={link.avatar}
                    alt=""
                    width="44"
                    height="44"
                    class="friend-avatar"
                    onerror={`this.onerror=null;this.src='/img/avatar-fail.png'`}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="friend-copy">
                    <strong>{link.title}</strong>
                    <span>{link.intro}</span>
                  </span>
                  <span class="friend-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="friend-empty">通讯录还是空的。</p>
        )
      }
    </section>

    {
      links.custom.enabled && (
        <section class="friend-custom" aria-labelledby="friend-custom-heading">
          <h2 id="friend-custom-heading">朋友圈</h2>
          <div class="friend-custom__content" set:html={links.custom.html} />
        </section>
      )
    }
  </JournalPage>
</Layout>

<style>
  .friend-custom h2 {
    margin: 0;
    color: rgb(38 38 38);
    font-size: 1.02rem;
    font-weight: 680;
    letter-spacing: 0;
  }

  :global(.dark) .friend-custom h2 {
    color: rgb(229 229 229);
  }

  .friend-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .friend-list > li {
    min-width: 0;
    border-bottom: 1px dashed rgb(212 212 212 / 0.72);
  }

  .friend-link {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 1.5rem;
    align-items: center;
    gap: 1rem;
    min-height: 5.6rem;
    margin-inline: -0.65rem;
    padding: 0.8rem 0.65rem;
    border-radius: 0.25rem;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .friend-link:hover {
    background: rgb(245 245 245 / 0.58);
  }

  .friend-link:focus-visible {
    outline: 2px solid hsl(var(--primary) / 0.72);
    outline-offset: 2px;
  }

  :global(.dark) .friend-list,
  :global(.dark) .friend-list > li {
    border-color: rgb(64 64 64 / 0.9);
  }

  :global(.dark) .friend-link:hover {
    background: rgb(38 38 38 / 0.54);
  }

  .friend-avatar {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(212 212 212 / 0.75);
    border-radius: 50%;
    background: rgb(250 250 250);
    object-fit: cover;
  }

  :global(.dark) .friend-avatar {
    border-color: rgb(82 82 82 / 0.75);
    background: rgb(38 38 38);
  }

  .friend-copy {
    min-width: 0;
  }

  .friend-copy strong,
  .friend-copy > span {
    display: block;
  }

  .friend-copy strong {
    color: rgb(38 38 38);
    font-size: 0.93rem;
    font-weight: 650;
    transition: color 160ms ease;
  }

  .friend-copy > span {
    overflow: hidden;
    margin-top: 0.25rem;
    color: rgb(115 115 115);
    font-size: 0.78rem;
    line-height: 1.6;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-arrow {
    color: rgb(163 163 163);
    font-size: 0.9rem;
    transition: color 160ms ease, transform 160ms ease;
  }

  .friend-link:hover .friend-copy strong,
  .friend-link:hover .friend-arrow {
    color: hsl(var(--primary));
  }

  .friend-link:hover .friend-arrow {
    transform: translate(0.1rem, -0.1rem);
  }

  :global(.dark) .friend-copy strong {
    color: rgb(229 229 229);
  }

  :global(.dark) .friend-copy > span {
    color: rgb(163 163 163);
  }

  .friend-empty {
    margin: 0;
    padding: 2rem 0;
    border-block: 1px solid rgb(229 229 229 / 0.72);
    color: rgb(115 115 115);
    font-size: 0.82rem;
  }

  .friend-custom {
    margin-top: 4rem;
  }

  .friend-custom__content {
    margin-top: 1rem;
    color: rgb(82 82 82);
    font-size: 0.86rem;
    line-height: 1.8;
  }

  .friend-custom__content :global(a) {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-decoration-color: hsl(var(--primary) / 0.28);
    text-underline-offset: 0.22rem;
  }

  .friend-custom__content :global(a:hover) {
    text-decoration-color: hsl(var(--primary) / 0.8);
  }

  .friend-custom__content :global(a:focus-visible) {
    outline: 2px solid hsl(var(--primary) / 0.72);
    outline-offset: 3px;
  }

  :global(.dark) .friend-empty {
    border-color: rgb(64 64 64 / 0.9);
  }

  :global(.dark) .friend-custom__content {
    color: rgb(190 190 190);
  }

  @media (max-width: 640px) {
    .friend-list {
      grid-template-columns: 1fr;
    }

    .friend-link {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1rem;
      gap: 0.8rem;
      min-height: 5rem;
    }

    .friend-avatar {
      width: 2.5rem;
      height: 2.5rem;
    }

    .friend-copy > span {
      white-space: normal;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .friend-custom {
      margin-top: 3.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-link,
    .friend-copy strong,
    .friend-arrow {
      transition: none;
    }
  }
</style>
