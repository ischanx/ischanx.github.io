---
import Layout from '../layouts/Layout.astro';
import { links, site } from '../config';
---

<Layout
  title="友链"
  description={`浏览 ${site.title} 推荐的博客与个人站点。`}
>
  <div class="mx-auto max-w-6xl px-4 py-8 md:py-12">
    <header class="mb-8 md:mb-10">
      <p class="mb-2 text-sm font-medium text-primary-600 dark:text-primary-400">
        Community links
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        友链
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-neutral-600 dark:text-neutral-400">
        一些值得访问的博客与个人站点。
      </p>
    </header>

    <section aria-labelledby="links-heading">
      <h2 id="links-heading" class="sr-only">博客列表</h2>
      {
        links.items.length > 0 ? (
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {links.items.map(link => (
              <a
                href={link.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex min-w-0 items-start gap-4 rounded-lg border border-neutral-200 bg-neutral-50/70 p-4 transition-colors duration-200 hover:border-primary-300 hover:bg-primary-50/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:border-neutral-800 dark:bg-neutral-900/60 dark:hover:border-primary-700 dark:hover:bg-primary-950/20 dark:focus-visible:ring-offset-neutral-950"
                aria-label={`访问 ${link.title} 的博客`}
              >
                <img
                  src={link.avatar}
                  alt=""
                  width="48"
                  height="48"
                  class="h-12 w-12 shrink-0 rounded-md border border-neutral-200 bg-white object-cover dark:border-neutral-700 dark:bg-neutral-800"
                  onerror={`this.src='/img/avatar-fail.png'`}
                  loading="lazy"
                />
                <span class="min-w-0 flex-1">
                  <span class="flex items-start justify-between gap-3">
                    <span class="min-w-0 truncate text-base font-semibold text-neutral-900 transition-colors group-hover:text-primary-700 dark:text-neutral-100 dark:group-hover:text-primary-300">
                      {link.title}
                    </span>
                    <span
                      aria-hidden="true"
                      class="shrink-0 text-sm text-neutral-400 transition-colors group-hover:text-primary-500 dark:text-neutral-500 dark:group-hover:text-primary-400"
                    >
                      ↗
                    </span>
                  </span>
                  <span class="mt-1 block line-clamp-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400">
                    {link.intro}
                  </span>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <p class="border-y border-neutral-200 py-8 text-sm text-neutral-500 dark:border-neutral-800 dark:text-neutral-400">
            暂无友链。
          </p>
        )
      }
    </section>

    {
      links.custom.enabled && (
        <section class="mt-10 border-t border-neutral-200 pt-8 dark:border-neutral-800">
          <h2 class="mb-3 text-sm font-semibold text-neutral-900 dark:text-neutral-100">
            朋友圈
          </h2>
          <div
            class="prose prose-sm max-w-none text-neutral-600 dark:prose-invert dark:text-neutral-400"
            set:html={links.custom.html}
          />
        </section>
      )
    }

  </div>
</Layout>
