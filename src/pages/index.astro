---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../config';
import { sortPosts } from '../utils/posts';

const { hero } = site.home;
const heroHeadingParts = hero.heading.match(/^(.*?)(好奇)(，)(.+)$/);

// 获取文章
const posts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// 使用工具函数对文章进行排序
const sortedPosts = sortPosts(posts);
const recentPosts = sortedPosts.slice(0, 10);
---

<Layout>
  <div class="home-content mx-auto max-w-6xl px-3 sm:px-4">
    <div class="home-backdrop" aria-hidden="true">
      <img
        src="/img/home-hero.webp"
        alt=""
        width="1672"
        height="941"
        loading="eager"
        decoding="async"
        fetchpriority="low"
      />
    </div>

    <section class="blog-hero" aria-labelledby="hero-title">
      <div class="blog-hero__copy">
        <div class="blog-hero__identity" data-home-enter>
          <img
            src={site.avatar}
            alt={`${site.author} 的头像`}
            width="64"
            height="64"
            loading="eager"
            decoding="async"
          />
          <p class="blog-hero__hello">
            <strong>{site.title}</strong>
            <span>{hero.greeting}</span>
          </p>
        </div>

        <h1
          id="hero-title"
          class="blog-hero__title"
          aria-label={hero.heading}
          data-home-enter
        >
          {
            heroHeadingParts ? (
              <>
                <span class="blog-hero__title-clause">
                  <span>{heroHeadingParts[1]}</span>
                  <span class="blog-hero__circled">
                    {heroHeadingParts[2]}
                    <svg
                      class="blog-hero__circle"
                      viewBox="0 0 200 100"
                      preserveAspectRatio="none"
                      aria-hidden="true"
                    >
                      <path d="M6 52C8 18 52 5 101 8c50 3 91 16 94 43 3 28-40 43-94 43C48 94 4 80 6 52Z" />
                      <path d="M10 56C8 29 47 11 105 10c55-1 88 16 88 43 0 25-36 38-91 40C44 95 12 82 10 56Z" />
                    </svg>
                  </span>
                  <span>{heroHeadingParts[3]}</span>
                </span>
                <span class="blog-hero__highlight">
                  {heroHeadingParts[4]}
                  <svg
                    class="blog-hero__underline"
                    viewBox="0 0 520 24"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    <path d="M4 15c87-7 176-9 261-7 91 2 166 7 251 3" />
                    <path d="M9 19c105-5 211-5 315-3 63 1 126 1 187-2" />
                  </svg>
                </span>
              </>
            ) : (
              hero.heading
            )
          }
        </h1>

        <p class="blog-hero__intro" data-home-enter>
          {hero.summary}
        </p>
      </div>
    </section>

    <section class="home-feed" aria-label="最近文章">
      <div class="home-post-list">
      {
        recentPosts.map(post => (
          <div class="w-full" data-home-post>
            <PostCard post={post} variant="list" />
          </div>
        ))
      }
      </div>

      <div class="home-feed__archive">
        <a href="/archives">
          查看更多
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-content {
    --home-accent: #525252;
    --home-surface-rgb: 255 255 255;
    isolation: isolate;
    position: relative;
    z-index: 1;
  }

  :global(.dark) .home-content {
    --home-accent: #a3a3a3;
    --home-surface-rgb: 25 25 25;
  }

  .blog-hero {
    --blog-hero-ink: #171717;
    --blog-hero-muted: #5f5f5f;
    --blog-hero-line: rgb(23 23 23 / 0.15);
    --blog-hero-sketch: #3157d5;
    --blog-hero-avatar-glow: hsl(var(--primary) / 0.14);
    margin: 0 auto 3.5rem;
    max-width: 56rem;
    padding: clamp(2.25rem, 5vw, 3.75rem) 0 1.5rem;
    position: relative;
  }

  .home-backdrop {
    height: clamp(22rem, 38vw, 31rem);
    inset: -2rem 0 auto;
    mask-image: linear-gradient(to bottom, #000 0%, #000 68%, transparent 100%);
    overflow: hidden;
    pointer-events: none;
    position: absolute;
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 68%,
      transparent 100%
    );
    z-index: -1;
  }

  .home-backdrop img {
    height: 100%;
    object-fit: cover;
    object-position: 55% 52%;
    opacity: 0.4;
    width: 100%;
  }

  .home-backdrop::after {
    background: linear-gradient(
      90deg,
      rgb(var(--home-surface-rgb) / 0.99) 0%,
      rgb(var(--home-surface-rgb) / 0.94) 36%,
      rgb(var(--home-surface-rgb) / 0.5) 68%,
      rgb(var(--home-surface-rgb) / 0.12) 88%,
      rgb(var(--home-surface-rgb) / 0.99) 100%
    );
    content: '';
    inset: 0;
    position: absolute;
  }

  .blog-hero__copy {
    max-width: 48rem;
    position: relative;
    z-index: 1;
  }

  .blog-hero__identity {
    align-items: center;
    display: flex;
    gap: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .blog-hero__identity img {
    animation: hero-avatar-breathe 4.2s ease-in-out infinite;
    border-radius: 999px;
    box-shadow:
      0 0 0 1px var(--blog-hero-line),
      0 0 0 0 var(--blog-hero-avatar-glow);
    height: 3rem;
    object-fit: cover;
    width: 3rem;
  }

  @keyframes hero-avatar-breathe {
    50% {
      box-shadow:
        0 0 0 1px var(--blog-hero-line),
        0 0 0 0.45rem var(--blog-hero-avatar-glow);
    }
  }

  .blog-hero__hello {
    color: var(--blog-hero-muted);
    display: flex;
    flex-direction: column;
    font-size: 0.82rem;
    line-height: 1.5;
    margin: 0;
  }

  .blog-hero__hello strong {
    color: var(--blog-hero-ink);
    font-size: 1rem;
    font-weight: 700;
  }

  .blog-hero__title {
    align-items: baseline;
    color: var(--blog-hero-ink);
    column-gap: 0.08em;
    display: flex;
    font-size: clamp(2.55rem, 4vw, 3.6rem);
    flex-wrap: wrap;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.12;
    margin: 0;
    row-gap: 0.08em;
    text-wrap: balance;
  }

  .blog-hero__title-clause {
    display: inline-flex;
  }

  .blog-hero__circled,
  .blog-hero__highlight {
    display: inline-block;
    position: relative;
  }

  .blog-hero__circle {
    fill: none;
    height: 1.22em;
    left: 50%;
    overflow: visible;
    pointer-events: none;
    position: absolute;
    stroke: var(--blog-hero-sketch);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    top: 50%;
    transform: translate(-50%, -48%) rotate(-2deg);
    width: 2.28em;
  }

  .blog-hero__circle path:last-child {
    opacity: 0.34;
  }

  .blog-hero__underline {
    bottom: -0.06em;
    fill: none;
    height: 0.2em;
    left: 0;
    overflow: visible;
    pointer-events: none;
    position: absolute;
    stroke: var(--blog-hero-sketch);
    stroke-linecap: round;
    stroke-width: 1.25;
    width: 100%;
  }

  .blog-hero__underline path:last-child {
    opacity: 0.38;
  }

  .blog-hero__intro {
    color: var(--blog-hero-muted);
    font-size: clamp(0.98rem, 1.4vw, 1.08rem);
    line-height: 1.8;
    margin: 1.5rem 0 0;
    max-width: 46rem;
    text-wrap: pretty;
  }

  .home-feed {
    margin: 0 auto;
    max-width: 56rem;
  }

  .home-post-list {
    border-top: 1px dashed rgb(212 212 212 / 0.55);
  }

  .home-feed__archive {
    align-items: center;
    display: flex;
    font-size: 0.78rem;
    justify-content: center;
    padding: 2.75rem 0 1rem;
    text-align: center;
  }

  .home-feed__archive a {
    align-items: center;
    position: relative;
    background: transparent;
    border: 0;
    color: #404040;
    display: inline-flex;
    font-weight: 650;
    gap: 0.65rem;
    justify-content: center;
    min-width: 8.5rem;
    padding: 0.72rem 1.15rem;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .home-feed__archive a::before,
  .home-feed__archive a::after {
    position: absolute;
    pointer-events: none;
    border: 1.5px solid rgb(115 115 115 / 0.72);
    content: '';
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .home-feed__archive a::before {
    inset: 0.08rem -0.2rem;
    border-radius: 48% 52% 46% 54% / 53% 47% 55% 45%;
    transform: rotate(0.7deg);
  }

  .home-feed__archive a::after {
    inset: 0.14rem -0.14rem 0.04rem -0.25rem;
    border-radius: 52% 48% 54% 46% / 46% 54% 45% 55%;
    opacity: 0.34;
    transform: rotate(-0.9deg);
  }

  .home-feed__archive a:hover {
    color: hsl(var(--primary));
    transform: translateY(-1px);
  }

  .home-feed__archive a:hover::before,
  .home-feed__archive a:hover::after {
    border-color: hsl(var(--primary) / 0.82);
  }

  .home-feed__archive a span {
    transition: transform 180ms ease;
  }

  .home-feed__archive a:hover span {
    transform: translateX(2px);
  }

  .home-feed__archive a:focus-visible {
    outline: none;
  }

  .home-feed__archive a:focus-visible::before {
    border-color: hsl(var(--primary));
    box-shadow: 0 0 0 3px hsl(var(--primary) / 0.18);
  }

  :global(.dark) .blog-hero {
    --blog-hero-ink: #eeeeee;
    --blog-hero-muted: #ababab;
    --blog-hero-line: rgb(255 255 255 / 0.13);
    --blog-hero-sketch: #7e9eff;
    --blog-hero-avatar-glow: hsl(var(--primary) / 0.2);
  }

  :global(.dark) .home-backdrop img {
    filter: brightness(0.55) saturate(0.72);
    opacity: 0.24;
  }

  :global(.dark) .home-backdrop::after {
    background: linear-gradient(
      90deg,
      rgb(var(--home-surface-rgb) / 0.99) 0%,
      rgb(var(--home-surface-rgb) / 0.96) 42%,
      rgb(var(--home-surface-rgb) / 0.64) 72%,
      rgb(var(--home-surface-rgb) / 0.38) 88%,
      rgb(var(--home-surface-rgb) / 0.98) 100%
    );
  }

  :global(.dark) .home-post-list {
    border-top-color: rgb(82 82 82 / 0.58);
  }

  :global(.dark) .home-feed__archive a {
    color: rgb(212 212 212);
  }

  :global(.dark) .home-feed__archive a::before,
  :global(.dark) .home-feed__archive a::after {
    border-color: rgb(163 163 163 / 0.68);
  }

  :global(.dark) .home-feed__archive a:hover {
    color: hsl(var(--primary));
  }

  :global(.dark) .home-feed__archive a:hover::before,
  :global(.dark) .home-feed__archive a:hover::after {
    border-color: hsl(var(--primary) / 0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-hero__identity img {
      animation: none;
    }

    .home-feed__archive a,
    .home-feed__archive a span {
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .blog-hero {
      margin: -0.25rem auto 2.5rem;
      padding: 2rem 0 0.5rem;
    }

    .home-backdrop {
      inset-inline: -0.25rem;
    }

    .home-backdrop img {
      object-position: 62% 52%;
      opacity: 0.18;
    }

    .home-backdrop::after {
      background: linear-gradient(
        90deg,
        rgb(var(--home-surface-rgb) / 0.92) 0%,
        rgb(var(--home-surface-rgb) / 0.76) 58%,
        rgb(var(--home-surface-rgb) / 0.5) 86%,
        rgb(var(--home-surface-rgb) / 0.92) 100%
      );
    }

    :global(.dark) .home-backdrop img {
      opacity: 0.14;
    }

    :global(.dark) .home-backdrop::after {
      background: linear-gradient(
        90deg,
        rgb(var(--home-surface-rgb) / 0.9) 0%,
        rgb(var(--home-surface-rgb) / 0.7) 20%,
        rgb(var(--home-surface-rgb) / 0.7) 80%,
        rgb(var(--home-surface-rgb) / 0.9) 100%
      );
    }

    .blog-hero__hello {
      font-size: 0.78rem;
    }

    .blog-hero__identity {
      margin-bottom: 1.25rem;
    }

    .blog-hero__identity img {
      height: 3rem;
      width: 3rem;
    }

    .blog-hero__title {
      font-size: clamp(2.35rem, 10.5vw, 2.85rem);
      letter-spacing: 0;
      line-height: 1.14;
    }

    .blog-hero__intro {
      font-size: 0.94rem;
      line-height: 1.75;
      margin-top: 1.25rem;
    }

    .home-feed__header {
      align-items: center;
    }

    .home-feed__header h2 {
      font-size: 1.125rem;
    }

  }
</style>

<script>
  import { animate, inView, stagger } from 'motion';

  interface WindowWithHomeEffects extends Window {
    homeMotionCleanup?: () => void;
  }

  const initializeHomeMotion = () => {
    const windowWithMotion = window as WindowWithHomeEffects;
    const entranceElements = Array.from(
      document.querySelectorAll<HTMLElement>('[data-home-enter]')
    );
    const revealElements = Array.from(
      document.querySelectorAll<HTMLElement>(
        '[data-home-reveal], [data-home-post]'
      )
    );
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    windowWithMotion.homeMotionCleanup?.();

    if (reduceMotion) {
      [...entranceElements, ...revealElements].forEach(element => {
        element.style.removeProperty('opacity');
        element.style.removeProperty('transform');
      });
      windowWithMotion.homeMotionCleanup = () => {};
      return;
    }

    const animations: Array<{ stop: () => void }> = [];
    const revealedElements = new WeakSet<Element>();

    if (entranceElements.length > 0) {
      animations.push(
        animate(
          entranceElements,
          {
            opacity: [0, 1],
            transform: ['translateY(18px)', 'translateY(0px)'],
          },
          {
            duration: 1,
            delay: stagger(0.2),
            ease: [0.22, 1, 0.36, 1],
          }
        )
      );
    }

    revealElements.forEach(element => {
      element.style.opacity = '0';
      element.style.transform = 'translateY(14px)';
    });

    const stopInView = inView(
      revealElements,
      element => {
        if (revealedElements.has(element)) return;
        revealedElements.add(element);

        animations.push(
          animate(
            element,
            {
              opacity: [0, 1],
              transform: ['translateY(14px)', 'translateY(0px)'],
            },
            {
              delay: element.hasAttribute('data-home-post') ? 0.12 : 0,
              duration: 0.74,
              ease: [0.22, 1, 0.36, 1],
            }
          )
        );
      },
      {
        amount: 0.15,
        margin: '0px 0px -6% 0px',
      }
    );

    windowWithMotion.homeMotionCleanup = () => {
      stopInView();
      animations.forEach(animation => animation.stop());
    };
  };

  initializeHomeMotion();
  document.addEventListener('astro:page-load', initializeHomeMotion);
</script>
