---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../config';
import { sortPosts } from '../utils/posts';

const { hero } = site.home;

// 获取文章
const posts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// 使用工具函数对文章进行排序
const sortedPosts = sortPosts(posts);
const recentPosts = sortedPosts.slice(0, 10);
---

<Layout>
  <div class="home-content mx-auto max-w-6xl px-3 sm:px-4">
    <section class="blog-hero" aria-labelledby="hero-title">
      <div class="blog-hero__copy">
        <div class="blog-hero__identity" data-home-enter>
          <img
            src={site.avatar}
            alt={`${site.author} 的头像`}
            width="64"
            height="64"
            loading="eager"
            decoding="async"
          />
          <p class="blog-hero__hello">
            <strong>{site.title}</strong>
            <span>{hero.greeting}</span>
          </p>
        </div>

        <h1 id="hero-title" class="blog-hero__title" data-home-enter>
          {hero.headingPrefix}
          <span>
            {hero.headingHighlight}
            <svg viewBox="0 0 520 24" preserveAspectRatio="none" aria-hidden="true">
              <path d="M4 15c87-7 176-9 261-7 91 2 166 7 251 3"></path>
              <path d="M9 19c105-5 211-5 315-3 63 1 126 1 187-2"></path>
            </svg>
          </span>
        </h1>

        <p class="blog-hero__intro" data-home-enter>
          {hero.summary}
        </p>
      </div>

      <aside
        class="blog-hero__dialogue"
        data-hero-dialogues={JSON.stringify(hero.conversations)}
        data-hero-dialogue
      >
        <div class="blog-hero__turn">
          <p data-hero-question>{hero.conversations[0].question}</p>
        </div>
        <div class="blog-hero__turn is-answer">
          <p>
            <span
              data-hero-stream
            >
              {hero.conversations[0].answer}
            </span>
            <i class="blog-hero__cursor" aria-hidden="true"></i>
          </p>
        </div>
      </aside>
    </section>

    <section class="home-feed" aria-labelledby="latest-notes">
      <header class="home-feed__header" data-home-reveal>
        <h2 id="latest-notes">最近写下的东西</h2>
      </header>

      <div class="home-post-list">
      {
        recentPosts.map(post => (
          <div class="w-full" data-home-post>
            <PostCard post={post} variant="list" />
          </div>
        ))
      }
      </div>

      <div class="home-feed__archive">
        <a href="/archives">
          前往归档
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-content {
    --home-accent: #525252;
    position: relative;
    z-index: 1;
  }

  :global(.dark) .home-content {
    --home-accent: #a3a3a3;
  }

  .blog-hero {
    --blog-hero-ink: #171717;
    --blog-hero-muted: #5f5f5f;
    --blog-hero-line: rgb(23 23 23 / 0.15);
    --blog-hero-sketch: #3157d5;
    --blog-hero-question-background: rgb(245 245 245 / 0.82);
    --blog-hero-question-border: rgb(115 115 115 / 0.28);
    --blog-hero-answer-background: hsl(var(--primary) / 0.08);
    --blog-hero-answer-border: hsl(var(--primary) / 0.32);
    --blog-hero-answer-ink: hsl(var(--primary));
    margin: 1.25rem auto 4.5rem;
    min-height: 28rem;
    padding: clamp(4rem, 9vw, 7rem) 0 5rem;
    position: relative;
  }

  .blog-hero__copy {
    max-width: 52rem;
  }

  .blog-hero__identity {
    align-items: center;
    display: flex;
    gap: 0.9rem;
    margin-bottom: 1.8rem;
  }

  .blog-hero__identity img {
    border-radius: 999px;
    box-shadow: 0 0 0 1px var(--blog-hero-line);
    height: 3.25rem;
    object-fit: cover;
    width: 3.25rem;
  }

  .blog-hero__hello {
    color: var(--blog-hero-muted);
    display: flex;
    flex-direction: column;
    font-size: 0.82rem;
    line-height: 1.5;
    margin: 0;
  }

  .blog-hero__hello strong {
    color: var(--blog-hero-ink);
    font-size: 1rem;
    font-weight: 700;
  }

  .blog-hero__title {
    color: var(--blog-hero-ink);
    font-size: clamp(3.4rem, 7.4vw, 6.3rem);
    font-weight: 740;
    letter-spacing: -0.075em;
    line-height: 1.02;
    margin: 0;
    text-wrap: balance;
  }

  .blog-hero__title > span {
    display: inline-block;
    position: relative;
  }

  .blog-hero__title svg {
    bottom: -0.06em;
    fill: none;
    height: 0.2em;
    left: 0;
    overflow: visible;
    pointer-events: none;
    position: absolute;
    stroke: var(--blog-hero-sketch);
    stroke-linecap: round;
    stroke-width: 1.25;
    width: 100%;
  }

  .blog-hero__title path:last-child {
    opacity: 0.38;
  }

  .blog-hero__intro {
    color: var(--blog-hero-muted);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.85;
    margin: 2.2rem 0 0;
    max-width: 40rem;
    text-wrap: pretty;
  }

  .blog-hero__dialogue {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    position: absolute;
    right: 0.75rem;
    top: 10rem;
    width: 20rem;
    transition:
      opacity 360ms ease,
      transform 360ms ease;
  }

  .blog-hero__dialogue.is-changing {
    opacity: 0;
    transform: translateY(0.35rem);
  }

  .blog-hero__turn {
    align-items: flex-end;
    display: flex;
    flex-direction: column;
  }

  .blog-hero__turn.is-answer {
    align-items: flex-start;
  }

  .blog-hero__turn p {
    background: var(--blog-hero-question-background);
    border: 1px solid var(--blog-hero-question-border);
    border-radius: 0.95rem 0.95rem 0.2rem 0.95rem;
    box-shadow: 2px 2px 0 rgb(23 23 23 / 0.035);
    color: var(--blog-hero-ink);
    font-size: 0.82rem;
    line-height: 1.65;
    margin: 0;
    max-width: 92%;
    padding: 0.65rem 0.85rem;
  }

  .blog-hero__turn.is-answer p {
    background: var(--blog-hero-answer-background);
    border-color: var(--blog-hero-answer-border);
    border-radius: 0.95rem 0.95rem 0.95rem 0.2rem;
    box-shadow: -2px 2px 0 rgb(49 87 213 / 0.05);
    color: var(--blog-hero-answer-ink);
  }

  .blog-hero__cursor {
    animation: cursor-blink 0.8s steps(1) infinite;
    background: var(--blog-hero-answer-ink);
    display: inline-block;
    height: 0.95em;
    margin-left: 0.18rem;
    vertical-align: -0.08em;
    width: 1px;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  .home-feed {
    margin: 0 auto;
    max-width: 56rem;
  }

  .home-feed__header {
    align-items: end;
    display: flex;
    margin-bottom: 1.5rem;
  }

  .home-feed__header h2 {
    color: #171717;
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    font-weight: 720;
    letter-spacing: -0.04em;
  }

  .home-post-list {
    border-top: 1px solid rgb(212 212 212 / 0.95);
  }

  .home-feed__archive {
    align-items: center;
    display: flex;
    font-size: 0.78rem;
    justify-content: center;
    padding: 2.75rem 0 1rem;
    text-align: center;
  }

  .home-feed__archive a {
    align-items: center;
    background: #171717;
    border: 1px solid #171717;
    border-radius: 999px;
    color: #fff;
    display: inline-flex;
    font-weight: 650;
    gap: 0.65rem;
    justify-content: center;
    min-width: 8.5rem;
    padding: 0.72rem 1.15rem;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .home-feed__archive a:hover {
    background: var(--home-accent);
    border-color: var(--home-accent);
    color: #fff;
    transform: translateY(-2px);
  }

  .home-feed__archive a span {
    transition: transform 180ms ease;
  }

  .home-feed__archive a:hover span {
    transform: translateX(2px);
  }

  .home-feed__archive a:focus-visible {
    outline: 2px solid var(--home-accent);
    outline-offset: 4px;
  }

  :global(.dark) .blog-hero {
    --blog-hero-ink: #eeeeee;
    --blog-hero-muted: #ababab;
    --blog-hero-line: rgb(255 255 255 / 0.13);
    --blog-hero-sketch: #7e9eff;
    --blog-hero-question-background: rgb(48 48 48 / 0.78);
    --blog-hero-question-border: rgb(212 212 212 / 0.22);
    --blog-hero-answer-background: hsl(var(--primary) / 0.17);
    --blog-hero-answer-border: hsl(var(--primary) / 0.52);
  }

  :global(.dark) .blog-hero__turn p {
    box-shadow: 2px 2px 0 rgb(255 255 255 / 0.035);
  }

  :global(.dark) .blog-hero__turn.is-answer p {
    box-shadow: -2px 2px 0 rgb(126 158 255 / 0.065);
  }

  :global(.dark) .home-feed__header h2 {
    color: var(--theme-dark-page-title);
  }

  :global(.dark) .home-post-list {
    border-top-color: rgb(82 82 82 / 0.9);
  }

  :global(.dark) .home-feed__archive a {
    background: var(--theme-dark-page-title);
    border-color: var(--theme-dark-page-title);
    color: var(--theme-dark-page-bg);
  }

  :global(.dark) .home-feed__archive a:hover {
    background: var(--home-accent);
    border-color: var(--home-accent);
    color: #171717;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-feed__archive a,
    .home-feed__archive a span {
      transition: none;
    }

    .blog-hero__cursor {
      animation: none;
    }
  }

  @media (max-width: 1100px) {
    .blog-hero__dialogue {
      margin-top: 2.5rem;
      max-width: 21rem;
      position: relative;
      right: auto;
      top: auto;
    }
  }

  @media (max-width: 767px) {
    .blog-hero {
      margin: -0.25rem auto 2.25rem;
      min-height: auto;
      padding: 3.5rem 0 2.75rem;
    }

    .blog-hero__hello {
      font-size: 0.78rem;
    }

    .blog-hero__identity {
      margin-bottom: 1.5rem;
    }

    .blog-hero__identity img {
      height: 3rem;
      width: 3rem;
    }

    .blog-hero__title {
      font-size: clamp(3rem, 15vw, 4.4rem);
      letter-spacing: -0.08em;
      line-height: 1.06;
    }

    .blog-hero__intro {
      font-size: 0.94rem;
      line-height: 1.75;
      margin-top: 1.6rem;
    }

    .blog-hero__dialogue {
      margin: 2.25rem auto 0;
      width: calc(100% - 0.35rem);
    }

    .home-feed__header {
      align-items: center;
    }

  }
</style>

<script>
  import { animate, inView, stagger } from 'motion';

  interface WindowWithHomeEffects extends Window {
    homeStreamAbortController?: AbortController;
    homeMotionCleanup?: () => void;
  }

  const initializeHomeMotion = () => {
    const windowWithMotion = window as WindowWithHomeEffects;
    const entranceElements = Array.from(
      document.querySelectorAll<HTMLElement>('[data-home-enter]')
    );
    const revealElements = Array.from(
      document.querySelectorAll<HTMLElement>(
        '[data-home-reveal], [data-home-post]'
      )
    );
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    windowWithMotion.homeMotionCleanup?.();

    if (reduceMotion) {
      [...entranceElements, ...revealElements].forEach(element => {
        element.style.removeProperty('opacity');
        element.style.removeProperty('transform');
      });
      windowWithMotion.homeMotionCleanup = () => {};
      return;
    }

    const animations: Array<{ stop: () => void }> = [];
    const revealedElements = new WeakSet<Element>();

    if (entranceElements.length > 0) {
      animations.push(
        animate(
          entranceElements,
          {
            opacity: [0, 1],
            transform: ['translateY(18px)', 'translateY(0px)'],
          },
          {
            duration: 1,
            delay: stagger(0.2),
            ease: [0.22, 1, 0.36, 1],
          }
        )
      );
    }

    revealElements.forEach(element => {
      element.style.opacity = '0';
      element.style.transform = 'translateY(14px)';
    });

    const stopInView = inView(
      revealElements,
      element => {
        if (revealedElements.has(element)) return;
        revealedElements.add(element);

        animations.push(
          animate(
            element,
            {
              opacity: [0, 1],
              transform: ['translateY(14px)', 'translateY(0px)'],
            },
            {
              delay: element.hasAttribute('data-home-post') ? 0.12 : 0,
              duration: 0.74,
              ease: [0.22, 1, 0.36, 1],
            }
          )
        );
      },
      {
        amount: 0.15,
        margin: '0px 0px -6% 0px',
      }
    );

    windowWithMotion.homeMotionCleanup = () => {
      stopInView();
      animations.forEach(animation => animation.stop());
    };
  };

  const initializeHomeStream = () => {
    const dialogue = document.querySelector<HTMLElement>(
      '[data-hero-dialogue]'
    );
    const question = document.querySelector<HTMLElement>(
      '[data-hero-question]'
    );
    const output = document.querySelector<HTMLElement>('[data-hero-stream]');
    const windowWithStream = window as WindowWithHomeEffects;

    windowWithStream.homeStreamAbortController?.abort();
    if (!dialogue || !question || !output) return;

    const controller = new AbortController();
    const conversations = JSON.parse(
      dialogue.dataset.heroDialogues ?? '[]'
    ) as Array<{ question: string; answer: string }>;
    if (conversations.length === 0) return;
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (reduceMotion) {
      question.textContent = conversations[0].question;
      output.textContent = conversations[0].answer;
      windowWithStream.homeStreamAbortController = controller;
      return;
    }

    let conversationIndex = 0;
    let characterIndex = 0;
    let timer = 0;

    const schedule = (callback: () => void, delay: number) => {
      timer = window.setTimeout(callback, delay);
    };

    const showNextConversation = () => {
      if (controller.signal.aborted) return;

      dialogue.classList.add('is-changing');
      schedule(() => {
        conversationIndex = (conversationIndex + 1) % conversations.length;
        characterIndex = 0;
        question.textContent = conversations[conversationIndex].question;
        output.textContent = '';
        dialogue.classList.remove('is-changing');
        schedule(writeNextCharacter, 620);
      }, 380);
    };

    const writeNextCharacter = () => {
      if (controller.signal.aborted) return;

      const answer = conversations[conversationIndex].answer;
      characterIndex += 1;
      output.textContent = answer.slice(0, characterIndex);
      if (characterIndex >= answer.length) {
        schedule(showNextConversation, 4000);
        return;
      }

      const currentCharacter = answer[characterIndex - 1];
      const delay = /[，。！？]/.test(currentCharacter) ? 260 : 78;
      schedule(writeNextCharacter, delay);
    };

    controller.signal.addEventListener('abort', () => {
      window.clearTimeout(timer);
    });

    windowWithStream.homeStreamAbortController = controller;
    question.textContent = conversations[0].question;
    output.textContent = '';
    schedule(writeNextCharacter, 1900);
  };

  initializeHomeMotion();
  initializeHomeStream();
  document.addEventListener('astro:page-load', initializeHomeMotion);
  document.addEventListener('astro:page-load', initializeHomeStream);
</script>
